<style>
  .ip-section { margin-top: 0.6rem; }
  .ip-grid { display: grid; grid-template-columns: 1fr; gap: 1.6rem; }
  @media (min-width: 768px) { .ip-grid { grid-template-columns: 1fr 1fr; } }
  .ip-col-head {
    display: flex; align-items: baseline; justify-content: space-between;
    margin: 0 0 0.6rem;
  }
  .ip-col-head .ip-col-title {
    font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--global-theme-color);
  }
  .ip-col-head a.ip-col-title { text-decoration: none; }
  .ip-col-head a.ip-col-title:hover { text-decoration: underline; }
  .ip-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .ip-item {
    display: block; text-decoration: none; color: inherit;
    padding: 0.75rem 1rem; border-radius: 12px;
    border: 1px solid rgba(128, 128, 128, 0.18);
    background: rgba(128, 128, 128, 0.035);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .ip-item:hover {
    border-color: var(--global-theme-color);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
  }
  .ip-meta { display: flex; align-items: baseline; gap: 0.5rem; }
  .ip-chip {
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--global-theme-color); white-space: nowrap;
  }
  .ip-date { font-size: 0.72rem; opacity: 0.5; font-variant-numeric: tabular-nums; }
  .ip-title { font-weight: 600; font-size: 0.92rem; line-height: 1.4; margin-top: 0.15rem; }
  .ip-more {
    display: inline-block; margin-top: 0.7rem; font-size: 0.8rem;
    text-decoration: none; color: var(--global-theme-color);
  }
  .ip-more:hover { text-decoration: underline; }
</style>

<div class="ip-section">
  <div class="ip-grid">

    <div class="ip-col">
      <div class="ip-col-head">
        <a class="ip-col-title" href="{{ '/blog/' | relative_url }}">insights</a>
      </div>
      <div class="ip-list">
        {% comment %} Curated mix: pinned featured posts first, then remaining featured by date; falls back to latest if none {% endcomment %}
        {% assign ab_featured = site.aiblog | where: "featured", true %}
        {% if ab_featured.size > 0 %}
          {% assign ab_pinned = ab_featured | where: "pinned", true | sort: "date" | reverse %}
          {% assign ab_rest = ab_featured | where_exp: "p", "p.pinned != true" | sort: "date" | reverse %}
          {% assign ab_sorted = ab_pinned | concat: ab_rest %}
        {% else %}
          {% assign ab_sorted = site.aiblog | sort: "date" | reverse %}
        {% endif %}
        {% for item in ab_sorted limit: 6 %}
          <a class="ip-item" href="{{ item.url | relative_url }}">
            <div class="ip-meta">
              {% if item.tag %}<span class="ip-chip">{{ item.tag }}</span>{% endif %}
              <span class="ip-date">{{ item.date | date: '%b %-d, %Y' }}</span>
            </div>
            <div class="ip-title">{{ item.title | split: ": " | first }}</div>
          </a>
        {% endfor %}
      </div>
      <a class="ip-more" href="{{ '/blog/' | relative_url }}">View All Insights &rarr;</a>
    </div>

    <div class="ip-col">
      <div class="ip-col-head">
        <a class="ip-col-title" href="{{ '/papers/' | relative_url }}">paper reviews</a>
      </div>
      <div class="ip-list">
        {% assign pr_sorted = site.papers | sort: "date" | reverse %}
        {% for item in pr_sorted limit: 6 %}
          <a class="ip-item" href="{{ item.url | relative_url }}">
            <div class="ip-meta">
              {% if item.venue %}<span class="ip-chip">{{ item.venue }}</span>{% endif %}
              <span class="ip-date">{{ item.date | date: '%b %-d, %Y' }}</span>
            </div>
            <div class="ip-title">{{ item.title | split: ": " | first }}</div>
          </a>
        {% endfor %}
      </div>
      <a class="ip-more" href="{{ '/papers/' | relative_url }}">View All Reviews &rarr;</a>
    </div>

  </div>
</div>
