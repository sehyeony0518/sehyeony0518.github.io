{%- comment -%}
  Compact share row, placed at the top of study notes and insights. Every such
  page ships a 1200x630 preview card (bin/build_og_images.py) declared as
  og_image in its front matter, so a pasted link previews as the page's own
  header rather than as a profile photo.

  Copy is first because it is the one action that works everywhere, including
  the messengers that have no share URL. The native sheet appears only where
  navigator.share exists, which is where it is actually useful, and it is the
  route to those messengers on a phone.
{%- endcomment -%}
{%- assign share_url = page.url | absolute_url -%}
{%- assign share_title = page.title -%}

<div class="sh-row" data-url="{{ share_url }}" data-title="{{ share_title | escape }}">
  <button type="button" class="sh-btn" data-act="copy" aria-live="polite">Copy link</button>
  <a class="sh-btn" target="_blank" rel="noopener" aria-label="Share on X"
     href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&amp;text={{ share_title | url_encode }}">X</a>
  <a class="sh-btn" target="_blank" rel="noopener" aria-label="Share on LinkedIn"
     href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url | url_encode }}">LinkedIn</a>
  <button type="button" class="sh-btn" data-act="native" hidden>Share</button>
</div>

<style>
  /* The standalone margin suits an insight, where the theme renders its own
     header above. A note puts the row on its breadcrumb line and cancels it. */
  .sh-row {
    display: flex; flex-wrap: wrap; gap: .3rem; align-items: center;
    margin: .5rem 0 1.6rem;
  }

  .sh-btn {
    display: inline-flex; align-items: center; padding: .14rem .55rem;
    border-radius: 999px; cursor: pointer; white-space: nowrap;
    border: 1px solid rgba(128, 128, 128, 0.28); background: none;
    color: var(--global-text-color-light); opacity: .75;
    font-size: .695rem; font-weight: 600; line-height: 1.55;
    font-family: inherit; text-decoration: none;
    transition: border-color .15s ease, color .15s ease, opacity .15s ease;
  }
  .sh-btn:hover {
    border-color: var(--global-theme-color); color: var(--global-theme-color);
    opacity: 1; text-decoration: none;
  }
  .sh-btn.sh-done { border-color: var(--global-theme-color); color: var(--global-theme-color); opacity: 1; }
</style>

<script>
  (function () {
    var row = document.currentScript.previousElementSibling;
    while (row && !row.classList.contains('sh-row')) row = row.previousElementSibling;
    if (!row) return;
    var url = row.getAttribute('data-url');
    var title = row.getAttribute('data-title');

    var native = row.querySelector('[data-act="native"]');
    if (native && navigator.share) {
      native.hidden = false;
      native.addEventListener('click', function () {
        navigator.share({ title: title, url: url }).catch(function () {});
      });
    }

    var copy = row.querySelector('[data-act="copy"]');
    if (!copy) return;
    copy.addEventListener('click', function () {
      function done() {
        var was = copy.textContent;
        copy.textContent = 'Copied';
        copy.classList.add('sh-done');
        setTimeout(function () {
          copy.textContent = was;
          copy.classList.remove('sh-done');
        }, 1600);
      }
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = url;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          done();
        } catch (e) {
          copy.textContent = 'Press Ctrl+C';
        }
        document.body.removeChild(ta);
      }
      // The async clipboard needs a secure context and permission; the
      // execCommand path still works where it does not, so try both.
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(done, fallback);
      } else {
        fallback();
      }
    });
  })();
</script>
