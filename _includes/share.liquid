{%- comment -%}
  Share row for study notes and insights. Every such page ships a 1200x630
  preview card (bin/build_og_images.py) declared as og_image in its front
  matter, so a pasted link previews as the page's own header rather than as a
  profile photo.

  Copy is the first action because it is the one that works everywhere,
  including the messengers that have no share URL. The native sheet appears
  only where navigator.share exists, which is where it is actually useful.
{%- endcomment -%}
{%- assign share_url = page.url | absolute_url -%}
{%- assign share_title = page.title -%}

<div class="sh-row" data-url="{{ share_url }}" data-title="{{ share_title | escape }}">
  <h3 class="sh-label">Share</h3>
  <div class="sh-btns">
    <button type="button" class="sh-btn" data-act="copy" aria-live="polite">Copy link</button>
    <a class="sh-btn" data-act="x" target="_blank" rel="noopener"
       href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&amp;text={{ share_title | url_encode }}">X</a>
    <a class="sh-btn" data-act="li" target="_blank" rel="noopener"
       href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url | url_encode }}">LinkedIn</a>
    <a class="sh-btn" data-act="mail"
       href="mailto:?subject={{ share_title | url_encode }}&amp;body={{ share_url | url_encode }}">Email</a>
    <button type="button" class="sh-btn sh-native" data-act="native" hidden>More</button>
  </div>
</div>

<style>
  .sh-row { margin: 2rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--global-divider-color); }
  .sh-label {
    font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    color: var(--global-text-color-light); opacity: .8; margin: 0 0 .55rem;
  }
  .sh-btns { display: flex; flex-wrap: wrap; gap: .35rem; }
  .sh-btn {
    display: inline-flex; align-items: center; padding: .26rem .7rem;
    border-radius: 999px; cursor: pointer; white-space: nowrap;
    border: 1px solid rgba(128, 128, 128, 0.3); background: none; color: inherit;
    font-size: .755rem; font-weight: 550; line-height: 1.5;
    font-family: inherit; text-decoration: none;
    transition: border-color .15s ease, color .15s ease;
  }
  .sh-btn:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); text-decoration: none; }
  .sh-btn.sh-done { border-color: var(--global-theme-color); color: var(--global-theme-color); }
</style>

<script>
  (function () {
    var row = document.currentScript.previousElementSibling;
    while (row && !row.classList.contains('sh-row')) row = row.previousElementSibling;
    if (!row) return;
    var url = row.getAttribute('data-url');
    var title = row.getAttribute('data-title');

    var native = row.querySelector('[data-act="native"]');
    if (native && navigator.share) {
      native.hidden = false;
      native.addEventListener('click', function () {
        navigator.share({ title: title, url: url }).catch(function () {});
      });
    }

    var copy = row.querySelector('[data-act="copy"]');
    if (!copy) return;
    copy.addEventListener('click', function () {
      function done() {
        var was = copy.textContent;
        copy.textContent = 'Copied';
        copy.classList.add('sh-done');
        setTimeout(function () {
          copy.textContent = was;
          copy.classList.remove('sh-done');
        }, 1600);
      }
      // The async clipboard needs a secure context and permission; the
      // execCommand path still works where it does not, so try both.
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(done, fallback);
      } else {
        fallback();
      }
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = url;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          done();
        } catch (e) {
          copy.textContent = 'Press Ctrl+C';
        }
        document.body.removeChild(ta);
      }
    });
  })();
</script>
