{%- comment -%}
  A visible view counter. GoatCounter is used rather than the analytics options
  already wired into the theme because it is the only one that will hand back a
  number the page can print: /counter/TOTAL.json for the running total, and the
  same path with ?start=<today> for the day. It sets no cookies and collects no
  personal data, so no consent banner is owed.

  Nothing here loads until site.analytics.goatcounter is set.
{%- endcomment -%}
{%- assign gc = site.analytics.goatcounter -%}
{%- if gc and gc != "" -%}
  <span class="pv" id="pv" hidden title="views today / views all time">
    <b id="pv-day">–</b><span class="pv-sep">/</span><b id="pv-all">–</b>
  </span>

  <script data-goatcounter="https://{{ gc }}.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
  <script>
    (function () {
      var base = 'https://{{ gc }}.goatcounter.com/counter/TOTAL.json';
      // Local date, not UTC: "today" should mean the reader's today.
      var d = new Date();
      var today = d.getFullYear() + '-' +
                  String(d.getMonth() + 1).padStart(2, '0') + '-' +
                  String(d.getDate()).padStart(2, '0');
      var wrap = document.getElementById('pv');

      function put(id, url) {
        return fetch(url)
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (j) {
            if (!j || j.count == null) return false;
            document.getElementById(id).textContent = j.count;
            return true;
          })
          .catch(function () { return false; });
      }

      // Only reveal the line once at least one number arrived; a counter showing
      // dashes because the request failed is worse than no counter.
      // The markup is emitted in the footer because that is where the include
      // sits, but it belongs under the navbar with the contact icons. That bar is
      // built on DOMContentLoaded, so wait for it before moving in; if it never
      // appears the counter simply stays where it was rendered.
      function reseat() {
        var bar = document.getElementById('top-social-bar');
        if (bar && wrap.parentNode !== bar) { bar.appendChild(wrap); wrap.classList.add('pv-top'); }
      }

      Promise.all([
        put('pv-all', base),
        put('pv-day', base + '?start=' + today)
      ]).then(function (ok) {
        if (!(ok[0] || ok[1])) return;
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () { reseat(); wrap.hidden = false; });
        } else {
          reseat(); wrap.hidden = false;
        }
      });
    })();
  </script>

  <style>
    .pv {
      display: inline-flex; align-items: baseline; gap: .18rem;
      font-size: .72rem; opacity: .55; font-variant-numeric: tabular-nums;
      margin-left: .6rem; cursor: help;
    }
    .pv b { font-weight: 600; }
    .pv-sep { opacity: .45; }
    /* In the top bar it sits with the contact icons, so it takes their size and
       weight rather than the footer's. */
    .pv.pv-top { margin-left: .15rem; font-size: .7rem; opacity: .6; align-self: center; }
    .pv.pv-top:hover { opacity: .9; }
  </style>
{%- endif -%}
