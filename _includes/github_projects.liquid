{%- comment -%}
  The repositories, rendered from _data/github_projects.yml rather than fetched
  in the browser: readers never hit GitHub's unauthenticated rate limit, the row
  cannot fail to load, and the ordering stays deliberate. Refresh the data with
  bin/fetch_github_projects.py.
{%- endcomment -%}
{%- assign repos = site.data.github_projects -%}
{%- if repos and repos.size > 0 -%}
  <div class="gh-wrap">
    <div class="gh-head">
      <h2 class="gh-title">github projects</h2>
      <a class="gh-all" href="https://github.com/sehyeony0518" target="_blank" rel="noopener">all repositories&nbsp;&rarr;</a>
    </div>
    <div class="gh-grid">
      {%- for r in repos limit: 6 -%}
        <a class="gh-card" href="{{ r.url }}" target="_blank" rel="noopener">
          <span class="gh-name">{{ r.name }}</span>
          {%- if r.description %}<span class="gh-desc">{{ r.description | truncate: 128 }}</span>{% endif -%}
          <span class="gh-meta">
            {%- if r.language %}<span class="gh-lang">{{ r.language }}</span>{% endif -%}
            {%- if r.stars > 0 %}<span class="gh-star">★ {{ r.stars }}</span>{% endif -%}
            <span class="gh-date">{{ r.updated }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .gh-wrap { margin-top: 1.4rem; }
    .gh-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: .7rem; }
    .gh-title {
      margin: 0; font-size: .74rem; font-weight: 700; letter-spacing: .1em;
      text-transform: uppercase; color: var(--global-theme-color);
    }
    .gh-all { font-size: .74rem; text-decoration: none; color: var(--global-text-color-light); }
    .gh-all:hover { color: var(--global-theme-color); }
    /* Three across on a wide screen, two on a tablet, one on a phone. The cards
       are links end to end rather than a title link inside a box, so the whole
       card is the target. */
    .gh-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; }
    @media (max-width: 900px) { .gh-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .gh-grid { grid-template-columns: 1fr; } }
    .gh-card {
      display: flex; flex-direction: column; gap: .3rem;
      padding: .75rem .85rem; border-radius: 10px; text-decoration: none; color: inherit;
      border: 1px solid var(--global-divider-color); background: var(--global-card-bg-color);
      transition: border-color .15s ease, transform .15s ease;
    }
    .gh-card:hover { border-color: var(--global-theme-color); transform: translateY(-1px); }
    .gh-name { font-size: .84rem; font-weight: 600; line-height: 1.3; word-break: break-word; }
    .gh-desc { font-size: .76rem; line-height: 1.5; color: var(--global-text-color-light); }
    .gh-meta {
      display: flex; flex-wrap: wrap; gap: .55rem; margin-top: auto; padding-top: .2rem;
      font-size: .68rem; color: var(--global-text-color-light); font-variant-numeric: tabular-nums;
    }
    .gh-star { color: var(--global-theme-color); }
  </style>
{%- endif -%}
