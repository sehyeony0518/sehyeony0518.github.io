{%- comment -%}
  The repositories, rendered from _data/github_projects.yml rather than fetched
  in the browser: readers never hit GitHub's unauthenticated rate limit, the row
  cannot fail to load, and the ordering stays deliberate. Refresh the data with
  bin/fetch_github_projects.py.
{%- endcomment -%}
{%- assign repos = site.data.github_projects -%}
{%- if repos and repos.size > 0 -%}
  <div class="sec-wrap">
    <div class="sec-head">
      <h2 class="sec-title">github projects</h2>
      <a class="sec-all" href="https://github.com/sehyeony0518" target="_blank" rel="noopener">all repositories&nbsp;&rarr;</a>
    </div>
    <div class="sec-grid">
      {%- for r in repos limit: 6 -%}
        <a class="sec-card" href="{{ r.url }}" target="_blank" rel="noopener">
          <span class="sec-name">{{ r.name }}</span>
          {%- if r.description %}<span class="sec-desc">{{ r.description | truncate: 128 }}</span>{% endif -%}
          <span class="sec-meta">
            {%- if r.language %}<span class="sec-lang">{{ r.language }}</span>{% endif -%}
            {%- if r.stars > 0 %}<span class="sec-star">★ {{ r.stars }}</span>{% endif -%}
            <span class="sec-date">{{ r.updated }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>

  <style>
    /* Shared section chrome (.sec-head, .sec-grid, .sec-card and friends) is
       defined once in _layouts/about.liquid so the study, repository and
       insight rows are the same object. Only the repository extras are here. */
    .sec-star { color: var(--global-theme-color); }
  </style>
{%- endif -%}
