<style>
  /* ── Ground tone: off-white page, near-black text, elevated cards ────── */
  :root {
    --global-bg-color: #f9f9f9;
    --global-text-color: #1c1c1c;
    --global-text-color-light: #5f6368;
    --global-divider-color: rgba(28, 28, 28, 0.09);
  }
  html[data-theme="dark"] {
    --global-divider-color: rgba(232, 232, 232, 0.12);
  }
  /* Cards lift off the page instead of sinking into it */
  .paper-list .pr-item, .aiblog-list .ab-item, .ip-item, .proj-card {
    background: var(--global-card-bg-color);
    border-color: var(--global-divider-color);
  }

  /* ── Typography: Montserrat display + Inter text, airy academic rhythm ── */
  body {
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    font-weight: 400;
  }
  h1, h2, h3, h4, h5, h6,
  .post-title, .navbar-brand.title, .ip-col-title, .mission-title {
    font-family: Montserrat, Inter, sans-serif;
    letter-spacing: -0.018em;
  }
  /* Generous whitespace between sections; longer measure for prose */
  article h2, .post h2 { margin-top: 2.5rem; margin-bottom: 0.85rem; }
  article h3, .post h3 { margin-top: 1.9rem; margin-bottom: 0.6rem; }
  article p, .post p, article li, .post li { line-height: 1.75; }
  article p, .post p { margin-bottom: 1.1rem; }
  .post-description, .post-header .desc { letter-spacing: 0.005em; opacity: 0.72; }

  /* Bold section headings across content pages */
  article h1, article h2, article h3, article h4,
  .post h1, .post h2, .post h3, .post h4,
  .post-title, .header-bar h1 {
    font-weight: 700 !important;
  }
  /* Special home title */
  .mission-title {
    font-weight: 800 !important;
    letter-spacing: -0.015em;
    background: linear-gradient(120deg, currentColor 60%, var(--global-theme-color));
    -webkit-background-clip: text;
    background-clip: text;
  }
  .mission-title .m-year {
    color: var(--global-theme-color);
    -webkit-text-fill-color: var(--global-theme-color);
  }
  /* Language toggle: Korean shown by default, English hidden until data-lang=en */
  .lang-en { display: none; }
  html[data-lang="en"] .lang-en { display: block; }
  html[data-lang="en"] .lang-ko { display: none; }
  .lang-toggle-btn {
    background: none; border: 1px solid rgba(128,128,128,.4); border-radius: 999px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: .02em;
    padding: 0.08rem 0.5rem; margin-left: 0.2rem; cursor: pointer; color: inherit;
    line-height: 1.5; transition: all .15s ease;
  }
  .lang-toggle-btn:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); }
  /* Keep the brand visible in the navbar (including the home page) */
  #navbar .navbar-brand.title { opacity: 1 !important; }
  /* Keep brand + nav on ONE row, aligned with the content column (brand lines up with the page title) */
  @media (min-width: 576px) {
    #navbar > .container { flex-wrap: nowrap; justify-content: space-between; }
    #navbar .navbar-collapse { flex-basis: auto; width: auto; flex-grow: 0; }
    #navbar .navbar-nav { margin-left: auto; }
    #navbar .navbar-nav .nav-link { padding-left: 0.38rem; padding-right: 0.38rem; font-size: 0.85rem; }
    #navbar .navbar-brand.title { font-size: 1.1rem; }
  }
  /* Back link on individual reflection posts */
  .diary-back { display: inline-block; margin: 0 0 1.2rem; font-size: .85rem; text-decoration: none; color: var(--global-theme-color); }
  .diary-back:hover { text-decoration: underline; }

  /* ── Secret mission mode ─────────────────────────────────────────────
     Default (academic) mode hides the mission-side tabs and the KO/EN toggle.
     Clicking the profile photo on the home page toggles data-mode="mission". */
  html:not([data-mode="mission"]) #navbar li.nav-item:has(> a.nav-link[href*="/mission/"]),
  html:not([data-mode="mission"]) #navbar li.nav-item:has(> a.nav-link[href*="/team/"]),
  html:not([data-mode="mission"]) #navbar li.nav-item:has(> a.nav-link[href*="/ministry/"]),
  html:not([data-mode="mission"]) #navbar li.nav-item:has(> a.nav-link[href*="/prayer/"]),
  html:not([data-mode="mission"]) #navbar li.nav-item:has(> a.nav-link[href*="/photos/"]),
  html:not([data-mode="mission"]) #navbar li.nav-item:has(> a.nav-link[href*="/diary/"]),
  html:not([data-mode="mission"]) #navbar li.lang-toggle-li {
    display: none !important;
  }
  /* Mission mode hides the academic tabs (full tab swap between the two sites) */
  html[data-mode="mission"] #navbar li.nav-item:has(> a.nav-link[href="/"]),
  html[data-mode="mission"] #navbar li.nav-item:has(> a.nav-link[href*="/research/"]),
  html[data-mode="mission"] #navbar li.nav-item:has(> a.nav-link[href*="/publications/"]),
  html[data-mode="mission"] #navbar li.nav-item:has(> a.nav-link[href*="/blog/"]),
  html[data-mode="mission"] #navbar li.nav-item:has(> a.nav-link[href*="/gallery/"]),
  html[data-mode="mission"] #navbar li.nav-item:has(> a.nav-link[href*="/papers/"]) {
    display: none !important;
  }
  /* On mobile, the home profile photo moves to the very bottom of the page content */
  @media (max-width: 575.98px) {
    article:has(> .profile) { display: flex; flex-direction: column; }
    article:has(> .profile) > .profile { order: 99; float: none !important; width: 100%; max-width: 320px; margin: 1.2rem auto 0; }
  }
  /* Clickable profile photo on the mission page (the way back) */
  #mission-profile {
    float: right; width: min(28%, 220px); margin: 0 0 1rem 1.5rem;
    border-radius: 0.25rem; cursor: pointer;
    box-shadow: 0 2px 5px #00000029, 0 2px 10px #0000001f;
  }

  /* Small social-icon row, shown once under the navbar (same links as the footer) */
  #top-social-bar {
    display: none; /* becomes flex via JS once populated */
    justify-content: flex-end;
    gap: 0.85rem;
    padding: 0.35rem max(1rem, calc((100% - var(--max-content-width, 930px)) / 2 + 15px)) 0.35rem 1rem;
    font-size: 0.92rem;
    opacity: 0.75;
  }
  #top-social-bar a { color: inherit; }
  #top-social-bar a:hover { color: var(--global-theme-color); }
  #top-social-bar .contact-note { display: none; } /* keep only icons up top */
  #top-social-source { display: none; }
</style>

<script>
  (function () {
    // Secret mission mode — determined by the CURRENT PAGE (full separation, no stored state).
    // Mission-side paths show mission tabs only; everything else shows academic tabs only.
    var missionPaths = ['/mission', '/team', '/ministry', '/prayer', '/photos', '/news', '/diary'];
    var onMission = missionPaths.some(function (p) { return window.location.pathname.indexOf(p) === 0; });
    if (onMission) document.documentElement.setAttribute('data-mode', 'mission');

    // The profile photo is the door between the two sites.
    function hookProfile() {
      var home = document.querySelector('.profile img');
      if (home) home.addEventListener('click', function () { window.location.href = '/mission/'; });
      var mission = document.getElementById('mission-profile');
      if (mission) mission.addEventListener('click', function () { window.location.href = '/'; });
    }
    if (document.readyState !== 'loading') hookProfile();
    else document.addEventListener('DOMContentLoaded', hookProfile);

    // Duplicate the footer's social icons into a small bar right under the navbar,
    // so they're visible without scrolling to the page bottom.
    function addTopSocialBar() {
      var source = document.getElementById('top-social-source');
      var nav = document.getElementById('navbar');
      if (!source || !nav || document.getElementById('top-social-bar')) return;
      var icons = source.querySelector('.contact-icons');
      if (!icons || !icons.children.length) return;
      var bar = document.createElement('div');
      bar.id = 'top-social-bar';
      bar.innerHTML = icons.innerHTML;
      bar.style.display = 'flex';
      nav.parentNode.insertBefore(bar, nav.nextSibling);
    }
    if (document.readyState !== 'loading') addTopSocialBar();
    else document.addEventListener('DOMContentLoaded', addTopSocialBar);

    // On academic pages, strip mission-side entries from the Cmd-K search index.
    if (!onMission) {
      var missionRe = /\/(mission|team|ministry|prayer|photos|news|diary)\//;
      var tries = 0;
      var t = setInterval(function () {
        tries++;
        var n = document.querySelector('ninja-keys');
        if (n && n.data && n.data.length) {
          n.data = n.data.filter(function (item) {
            if (item.section === 'News' || item.section === 'Prayer') return false;
            if (item.handler && missionRe.test(item.handler.toString())) return false;
            return true;
          });
          clearInterval(t);
        } else if (tries > 40) {
          clearInterval(t);
        }
      }, 150);
    }
  })();

  (function () {
    var KEY = 'siteLang';
    function apply(lang) {
      document.documentElement.setAttribute('data-lang', lang);
      var btn = document.getElementById('lang-toggle-btn');
      if (btn) { btn.textContent = lang === 'ko' ? 'EN' : '한'; btn.title = lang === 'ko' ? 'View in English' : '한국어로 보기'; }
    }
    apply(localStorage.getItem(KEY) || 'ko');
    function inject() {
      var tc = document.querySelector('.toggle-container');
      if (!tc || document.getElementById('lang-toggle-btn')) return;
      var li = document.createElement('li');
      li.className = 'toggle-container lang-toggle-li';
      var b = document.createElement('button');
      b.id = 'lang-toggle-btn'; b.type = 'button'; b.className = 'lang-toggle-btn';
      var cur = localStorage.getItem(KEY) || 'ko';
      b.textContent = cur === 'ko' ? 'EN' : '한';
      b.setAttribute('aria-label', 'Toggle language');
      b.addEventListener('click', function () {
        var c = localStorage.getItem(KEY) || 'ko';
        var n = c === 'ko' ? 'en' : 'ko';
        localStorage.setItem(KEY, n); apply(n);
      });
      li.appendChild(b);
      tc.parentNode.insertBefore(li, tc);
    }
    if (document.readyState !== 'loading') inject();
    else document.addEventListener('DOMContentLoaded', inject);
  })();

  (function () {
    // al-folio hides the navbar brand on the home page; show the site name there too.
    function addBrand() {
      if (document.querySelector('.navbar-brand')) return;
      var nav = document.querySelector('#navbar .container') || document.querySelector('nav .container');
      if (!nav) return;
      var a = document.createElement('a');
      a.className = 'navbar-brand title font-weight-lighter';
      a.href = '/';
      a.textContent = 'Se-Hyeon Hwang';
      a.style.opacity = '1';
      nav.insertBefore(a, nav.firstChild);
    }
    if (document.readyState !== 'loading') addBrand();
    else document.addEventListener('DOMContentLoaded', addBrand);
  })();

  (function () {
    // Back link on individual reflection (diary) posts
    if (!/^\/diary\/\d{4}\/[^/]+\/?$/.test(window.location.pathname)) return;
    function addBack() {
      if (document.querySelector('.diary-back')) return;
      var c = document.querySelector('.post') || document.querySelector('article');
      if (!c) return;
      var a = document.createElement('a');
      a.className = 'diary-back';
      a.href = '/diary/';
      a.innerHTML = '&larr; reflections';
      c.insertBefore(a, c.firstChild);
    }
    if (document.readyState !== 'loading') addBack();
    else document.addEventListener('DOMContentLoaded', addBack);
  })();
</script>

<div id="top-social-source">
  <div class="contact-icons">{% social_links %}</div>
</div>

{% capture footer_contents %}
  {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
