{% comment %}
  Knowledge graph of the site's own corpus, drawn along the axis the research
  actually sits on. Clinical concepts on the left, computational concepts on the
  right, and every study note, paper review and insight linked to the concepts it
  discusses, so the writing that joins both sides is visible as such. Concept
  assignment is by keyword frequency over the corpus, computed at build time into
  assets/json/knowledge-graph.json.
  Params: full (true for the interactive version), height.
{% endcomment %}
{% assign kg_full = include.full | default: false %}
{% assign kg_h = include.height | default: 480 %}

<style>
  /* Light is the default; dark takes over with the site's own theme switch and
     with the system preference when the reader has not chosen. */
  .kg-wrap {
    position: relative; margin: .2rem 0 0;
    --kg-g1: #ffffff; --kg-g2: #f3f5f9; --kg-g3: #eceff5;
    --kg-border: rgba(0,0,0,.09);
    --kg-label: #22262e; --kg-label-stroke: #ffffff;
    --kg-hub: #101319;
    --kg-line: #55607a;
    --kg-halo-c: .13; --kg-halo-p: .10;
    --kg-tip-bg: #ffffff; --kg-tip-fg: #1c1c1c; --kg-tip-bd: rgba(0,0,0,.12);
    --kg-tip-sh: rgba(0,0,0,.14);
    --kg-dim: #8a94a6; --kg-node-stroke: #ffffff;
  }
  html[data-theme="dark"] .kg-wrap {
    --kg-g1: #16161f; --kg-g2: #0c0c12; --kg-g3: #08080c;
    --kg-border: rgba(255,255,255,.07);
    --kg-label: #cbd2dc; --kg-label-stroke: #0a0a0f;
    --kg-hub: #e8edf4;
    --kg-line: #6b7280;
    --kg-halo-c: .16; --kg-halo-p: .09;
    --kg-tip-bg: #12121a; --kg-tip-fg: #e8edf4; --kg-tip-bd: rgba(255,255,255,.11);
    --kg-tip-sh: rgba(0,0,0,.5);
    --kg-dim: #4b5563; --kg-node-stroke: #0a0a0f;
  }
  .kg-stage { position: relative; display: flex; align-items: stretch; gap: .7rem; }
  .kg-stage > .kg-box { flex: 1 1 auto; min-width: 0; }
  .kg-bar {
    flex: 0 0 auto; width: 12.4rem; display: flex; flex-direction: column;
    gap: .28rem; justify-content: flex-start;
  }
  @media (max-width: 700px) {
    .kg-stage { flex-direction: column; }
    .kg-bar { width: auto; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }
  }
  .kg-find {
    flex: 0 0 auto; width: 100%; box-sizing: border-box; margin-bottom: .3rem;
    padding: .38rem .6rem; border-radius: 8px; font-size: .74rem; line-height: 1.25;
    border: 1px solid var(--kg-border); background: none; color: inherit;
    transition: border-color .14s ease;
  }
  .kg-find::placeholder { color: var(--kg-dim); }
  .kg-find:focus { outline: none; border-color: var(--global-theme-color); }
  .kg-found {
    flex: 0 0 auto; font-size: .68rem; color: var(--kg-dim); margin: -.1rem 0 .3rem .1rem;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 700px) { .kg-find { width: 100%; } .kg-found { width: 100%; } }
  .kg-chip {
    flex: 0 0 auto;
    padding: .34rem .65rem; border-radius: 8px; cursor: pointer;
    border: 1px solid var(--kg-border); background: none; color: inherit;
    font-size: .74rem; font-weight: 600; letter-spacing: .005em; transition: all .14s ease;
    display: flex; align-items: center; gap: .45rem; text-align: left; line-height: 1.25;
  }
  @media (max-width: 700px) { .kg-chip { padding: .3rem .6rem; font-size: .72rem; } }
  .kg-chip i { width: .6rem; height: .6rem; border-radius: 50%; display: inline-block; flex: 0 0 auto; }
  .kg-chip:hover { border-color: currentColor; }
  .kg-chip { opacity: .62; }
  .kg-chip:hover { opacity: 1; }
  .kg-chip.on { opacity: 1; border-color: currentColor; background: rgba(128,128,128,.09); }
  .kg-all { margin-bottom: .4rem; justify-content: center; font-weight: 800;
            letter-spacing: .08em; text-transform: uppercase; font-size: .74rem; }
  .kg-box {
    position: relative; width: 100%; border-radius: 14px; overflow: hidden;
    border: 1px solid var(--kg-border);
    background:
      radial-gradient(90% 70% at 50% 40%, var(--kg-g1) 0%, var(--kg-g2) 55%, var(--kg-g3) 100%);
  }
  .kg-box svg { display: block; width: 100%; height: 100%; cursor: grab; }
  .kg-box svg.kg-drag { cursor: grabbing; }
  .kg-hint {
    position: absolute; left: 50%; bottom: .7rem; transform: translateX(-50%);
    padding: .22rem .7rem; border-radius: 999px; pointer-events: none;
    font-size: .68rem; letter-spacing: .04em; white-space: nowrap;
    color: var(--kg-tip-fg); background: var(--kg-tip-bg); border: 1px solid var(--kg-tip-bd);
    opacity: 0; transition: opacity .18s ease;
  }
  .kg-box:hover .kg-hint { opacity: .75; }
  .kg-box.kg-armed .kg-hint { opacity: 0; }
  .kg-canvas { opacity: 0; transition: opacity .6s ease; }
  .kg-canvas.kg-in { opacity: 1; }
  .kg-link { fill: none; transition: stroke-opacity .18s ease; }
  .kg-node { cursor: pointer; }
  .kg-node circle { transition: opacity .18s ease; }
  .kg-halo { pointer-events: none; }
  .kg-label {
    font-size: 9.5px; fill: var(--kg-label); pointer-events: none; font-weight: 600;
    letter-spacing: .005em; transition: opacity .18s ease;
    paint-order: stroke; stroke: var(--kg-label-stroke); stroke-width: 3px; stroke-linejoin: round;
  }
  .kg-label.kg-hub { font-size: 11px; font-weight: 700; fill: var(--kg-hub); }
  .kg-legendline { font-size: .7rem; opacity: .55; margin: .5rem 0 0; line-height: 1.6; }
  /* Links into the collections, pinned to the foot of the column */
  .kg-links { margin-top: auto; padding-top: .7rem; border-top: 1px solid var(--kg-border);
              display: flex; flex-direction: column; gap: .05rem; }
  .kg-links a {
    display: flex; align-items: baseline; gap: .4rem; padding: .3rem .1rem;
    text-decoration: none; color: inherit; font-size: .76rem; font-weight: 600;
    opacity: .72; transition: opacity .14s ease, color .14s ease;
  }
  .kg-links a:hover { opacity: 1; color: var(--global-theme-color); }
  .kg-links .kl-n { margin-left: auto; font-size: .68rem; font-weight: 700; opacity: .55;
                    font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) {
    .kg-links { margin-top: .5rem; flex-direction: row; flex-wrap: wrap; gap: .2rem .9rem; }
    .kg-links a { padding: .2rem 0; }
    .kg-links .kl-n { margin-left: .25rem; }
  }
  .kg-note { font-size: .75rem; opacity: .55; margin: .35rem 0 0; line-height: 1.6; }
  .kg-tip {
    position: absolute; pointer-events: none; opacity: 0; transition: opacity .12s ease;
    background: var(--kg-tip-bg); border: 1px solid var(--kg-tip-bd); color: var(--kg-tip-fg);
    border-radius: 8px; padding: .4rem .62rem; font-size: .76rem; max-width: 18rem;
    line-height: 1.4; box-shadow: 0 6px 22px var(--kg-tip-sh); z-index: 3;
  }
  .kg-tip b { display: block; font-size: .64rem; font-weight: 800; letter-spacing: .07em;
              text-transform: uppercase; opacity: .5; margin-bottom: .12rem; }
  .kg-tip .kg-triple { display: block; font-weight: 600; margin-bottom: .3rem; }
  .kg-tip .kg-triple em { font-style: normal; color: var(--global-theme-color); }
  .kg-tip .kg-note { display: block; font-weight: 400; opacity: .8; line-height: 1.45; }
  .kg-tip .kg-src { display: block; margin-top: .3rem; font-size: .62rem; opacity: .55;
                    font-variant-numeric: tabular-nums; }
  .kg-tip .kg-nosrc { font-style: italic; }
  .kg-cover { position: absolute; inset: 0; display: flex; align-items: center;
              justify-content: center; font-size: .78rem; color: var(--kg-dim); }
  .kg-title {
    position: absolute; left: .9rem; top: .7rem; z-index: 2;
    display: flex; gap: .55rem; align-items: baseline;
  }
  .kg-vw {
    font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    background: none; border: 0; padding: 0; font-family: inherit; line-height: 1.2;
    color: var(--kg-dim); cursor: pointer; transition: color .15s ease;
  }
  .kg-vw.on { color: var(--global-theme-color); cursor: default; }
  span.kg-vw { cursor: default; }
  .kg-vw:not(.on):hover { color: var(--kg-hub); }
  .kg-count {
    position: absolute; right: .75rem; bottom: .6rem; font-size: .66rem; color: var(--kg-dim);
    font-variant-numeric: tabular-nums; pointer-events: none; letter-spacing: .02em;
  }
</style>

<div class="kg-wrap">
  <div class="kg-stage">
    <div class="kg-box" id="kg-box{% if kg_full %}-full{% endif %}" style="height: {{ kg_h }}px;">
      <div class="kg-cover">Loading the graph…</div>
      <div class="kg-title">knowledge graph</div>
      <div class="kg-hint">click to zoom</div>
    </div>
    <div class="kg-bar" id="kg-bar{% if kg_full %}-full{% endif %}">
      <input class="kg-find" type="search" autocomplete="off" spellcheck="false"
             placeholder="search the graph" aria-label="Search the knowledge graph">
      <div class="kg-found" hidden></div>
      {%- assign n_study = site.study | where_exp: "n", "n.category" | size %}
      <div class="kg-links">
        <a href="{{ '/study/' | relative_url }}">study notes <span class="kl-n">{{ n_study }}</span></a>
        <a href="{{ '/papers/' | relative_url }}">paper reviews <span class="kl-n">{{ site.papers | size }}</span></a>
        <a href="{{ '/blog/' | relative_url }}">insights <span class="kl-n">{{ site.aiblog | size }}</span></a>
      </div>
    </div>
    <div class="kg-tip"></div>
  </div>
  {% unless kg_full %}<p class="kg-note">Clinical vocabulary across the top, computational across the bottom, and every piece of writing placed by what it actually discusses. <a href="{{ '/research/#graph' | relative_url }}">Open the full graph</a>.</p>{% endunless %}
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js" integrity="sha512-vc58qvvBdrDR4etbxMdlTt4GBQk1qjvyORR2nrsPsFPyrs+/u5c3+1Ct6upOgdZoIl7eq6k3a1UPDSNAQi/32A==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
<script>
  (function () {
    var boxId = 'kg-box{% if kg_full %}-full{% endif %}';
    var FULL = {{ kg_full }};
    var box = document.getElementById(boxId);
    if (!box) return;
    var wrap = box.closest('.kg-wrap');
    var tip = wrap.querySelector('.kg-tip');
    var stage = box.parentNode;
    var SECTOR_ORDER = ['Imaging & acquisition','Disease & pathology','Clinical practice',
                 'Interpretability','Auditing & causality','Evaluation & reliability','Systems & deployment'];
    var ORDER = SECTOR_ORDER;
    // Keeping every sector inside the burgundy arc capped the separation at about
    // 25 dE even with lightness doing the work, and at the size these dots are
    // drawn that still read as one colour. Hue now spans the wheel -- warm at the
    // clinical end, cool at the computational, so the axis is still legible in the
    // order -- with saturation capped so it stays an editorial palette rather than
    // a neon one. Separation is 45 dE in both themes; every step clears 3.9:1 on
    // its ground. The burgundy stays where it belongs, on the site's own type.
    var PALETTE = {
      dark: {
        'Imaging & acquisition':'#c0a055','Disease & pathology':'#c64f3b','Clinical practice':'#c56796',
        'Interpretability':'#b13dc4','Auditing & causality':'#5c73ce',
        'Evaluation & reliability':'#41a0bf','Systems & deployment':'#8addaf', _: '#6b7280'
      },
      light: {
        'Imaging & acquisition':'#967531','Disease & pathology':'#bb3a2f','Clinical practice':'#b04e81',
        'Interpretability':'#9a31b9','Auditing & causality':'#3154a5',
        'Evaluation & reliability':'#327078','Systems & deployment':'#278b40', _: '#7A8494'
      }
    };
    // The ontology rings on entity type rather than sector, so it needs its own
    // order and palette. Same construction: warm where evidence is gathered,
    // cool where it is judged, and the threats last.
    var ONTO_ORDER = ['EvidenceSource','Finding','ClinicalTarget','Standard',
                      'Method','ModelFamily','Metric','Property','Threat'];
    // Built from _data/ontology.yml so the graph and the study page cannot drift.
    var ONTO_PALETTE = { dark: { _: '#6b7280' }, light: { _: '#7A8494' } };
    {%- for c in site.data.ontology.colors %}
    ONTO_PALETTE.light['{{ c[0] }}'] = '{{ c[1].light }}';
    ONTO_PALETTE.dark['{{ c[0] }}'] = '{{ c[1].dark }}';
    {%- endfor %}
    function isDark() { return document.documentElement.getAttribute('data-theme') === 'dark'; }
    var SECTOR_COLOR = PALETTE[isDark() ? 'dark' : 'light'];
    function paint(d) { return SECTOR_COLOR[d.sector] || SECTOR_COLOR._; }
    var KIND = { concept: 'Concept', note: 'Study note', review: 'Paper review', insight: 'Insight' };
    var started = false;

    // Two datasets over the same concepts: the corpus graph, where every edge is
    // "this piece of writing discusses this concept", and the ontology, where the
    // concepts are typed and the edges are assertions between them. The ontology
    // is optional -- if its file is absent the switch simply does not appear.
    var VIEWS = { graph: null, onto: null };
    var view = 'graph';

    function boot() {
      if (started || !window.d3) return;
      started = true;
      var corpus = d3.json('{{ "/assets/json/knowledge-graph.json" | relative_url }}');
      var onto = d3.json('{{ "/assets/json/ontology.json" | relative_url }}').catch(function () { return null; });
      Promise.all([corpus, onto]).then(function (r) {
        VIEWS.graph = r[0];
        VIEWS.onto = r[1] && r[1].nodes && r[1].nodes.length ? r[1] : null;
        render(VIEWS.graph);
      }).catch(function () {
        box.innerHTML = '<div class="kg-cover">The graph could not be loaded.</div>';
      });
    }

    function chrome() {
      var t = '<div class="kg-title">';
      if (VIEWS.onto) {
        t += '<button type="button" class="kg-vw' + (view === 'graph' ? ' on' : '') + '" data-v="graph">knowledge graph</button>'
           + '<button type="button" class="kg-vw' + (view === 'onto' ? ' on' : '') + '" data-v="onto">ontology</button>';
      } else {
        t += '<span class="kg-vw on">knowledge graph</span>';
      }
      return t + '</div><div class="kg-hint">click to zoom</div>';
    }

    function render(data) {
      var onto = view === 'onto';
      SECTOR_COLOR = (onto ? ONTO_PALETTE : PALETTE)[isDark() ? 'dark' : 'light'];
      ORDER = onto ? ONTO_ORDER : SECTOR_ORDER;
      box.innerHTML = chrome();
      var vw = box.querySelector('.kg-title');
      vw.addEventListener('click', function (e) {
        var b = e.target.closest('.kg-vw[data-v]');
        if (!b || b.getAttribute('data-v') === view) return;
        view = b.getAttribute('data-v');
        render(VIEWS[view]);
      });
      var W = box.clientWidth, H = box.clientHeight;
      var R = FULL ? 0.95 : 0.72;
      var svg = d3.select(box).append('svg').attr('viewBox', [0, 0, W, H]);
      var g = svg.append('g').attr('class', 'kg-canvas');

      var cs = getComputedStyle(wrap);
      var CH = parseFloat(cs.getPropertyValue('--kg-halo-c')) || 0.16;
      var PH = parseFloat(cs.getPropertyValue('--kg-halo-p')) || 0.09;
      var maxPiece = d3.max(data.nodes.filter(function (d) { return d.kind !== 'concept'; }), function (d) { return d.deg; }) || 1;
      var maxHub = d3.max(data.nodes.filter(function (d) { return d.kind === 'concept'; }), function (d) { return d.deg; }) || 1;
      function radius(d) {
        if (d.kind === 'concept') return (3.6 + Math.sqrt(d.deg / maxHub) * 3.4) * R;
        return (2.0 + Math.sqrt(d.deg / maxPiece) * 2.0) * R;
      }

      var link = g.append('g')
        .selectAll('path').data(data.links).join('path')
        .attr('class', 'kg-link')
        .attr('stroke', function (d) { var t = d.target; return (t && SECTOR_COLOR[t.sector]) || SECTOR_COLOR._; })
        .attr('stroke-opacity', function (d) { return d.w > 1 ? 0.30 : 0.11; })
        .attr('stroke-width', function (d) { return (d.w > 1 ? 1.15 : 0.7) * R; });

      var node = g.append('g').selectAll('g').data(data.nodes).join('g').attr('class', 'kg-node');
      node.append('circle').attr('class', 'kg-halo')
        .attr('r', function (d) { return radius(d) * (d.kind === 'concept' ? 2.2 : 1.9); })
        .attr('fill', paint)
        .attr('fill-opacity', function (d) { return d.kind === 'concept' ? CH : PH; });
      node.append('circle')
        .attr('r', radius)
        .attr('fill', paint)
        .attr('fill-opacity', function (d) { return d.kind === 'concept' ? 1 : 0.82; })
        .attr('stroke', function (d) { return d.kind === 'concept' ? 'var(--kg-node-stroke)' : 'none'; })
        .attr('stroke-width', 1.2);

      var hubLabel = node.filter(function (d) { return d.kind === 'concept'; })
        .append('text').attr('class', 'kg-label kg-hub')
        .attr('dy', function (d) { return -radius(d) - 5 * R; })
        .attr('text-anchor', 'middle')
        .text(function (d) { return d.label; });

      // Fifty labels on a settling force layout will collide. Measure each one
      // once -- the text sits inside the zoomed group, so its size in layout
      // coordinates is fixed and the result does not change with zoom -- then
      // keep the labels greedily, busiest concept first. A concept that loses
      // its label still has its colour, its size and its tooltip.
      hubLabel.each(function (d) {
        var w = 0;
        try { w = this.getComputedTextLength(); } catch (e) {}
        d._lw = w || d.label.length * 5.6;
        d._lh = 11;
        d._ldy = -radius(d) - 5 * R;
      });
      function declutter() {
        var placed = [];
        var pad = 2.5;
        data.nodes
          .filter(function (d) { return d.kind === 'concept' && d._hidden !== true; })
          .sort(function (a, b) { return b.deg - a.deg; })
          .forEach(function (d) {
            var w = d._lw + pad * 2, h = d._lh + pad * 2;
            var x0 = d.x - w / 2, y0 = d.y + d._ldy - h, x1 = x0 + w, y1 = y0 + h;
            var hit = placed.some(function (p) {
              return !(x1 < p[0] || x0 > p[2] || y1 < p[1] || y0 > p[3]);
            });
            d._labelOn = !hit;
            if (!hit) placed.push([x0, y0, x1, y1]);
          });
        hubLabel.attr('display', function (d) { return d._labelOn === false ? 'none' : null; });
      }

      // Give each family its own territory so the four groups read as groups,
      // and cross-links between them bend toward each other rather than mixing.
      // Seven sectors around a ring, clinical through the top half and computational
      // through the bottom. Only concepts are placed; the writing settles wherever
      // its own links pull it, which is the part worth looking at.
      var cx = W / 2, cy = H / 2, rad = Math.min(W, H) * (FULL ? 0.46 : 0.50);
      // One slot per concept around the ring, ordered so a sector occupies a
      // contiguous arc. Sending six concepts to one sector anchor piled them up.
      var hubs = data.nodes.filter(function (d) { return d.kind === 'concept'; });
      hubs.sort(function (a, b) {
        var t = ORDER.indexOf(a.sector) - ORDER.indexOf(b.sector);
        return t || a.label.localeCompare(b.label);
      });
      var GAP = 0.055, span = (Math.PI * 2) - ORDER.length * GAP;
      var ANG = {}, at = -Math.PI / 2, prev = null;
      hubs.forEach(function (d) {
        if (prev !== null && d.sector !== prev) at += GAP;
        ANG[d.id] = at; at += span / hubs.length; prev = d.sector;
      });
      function ax(d) { return ANG[d.id] === undefined ? cx : cx + Math.cos(ANG[d.id]) * rad * 1.32; }
      function ay(d) { return ANG[d.id] === undefined ? cy : cy + Math.sin(ANG[d.id]) * rad * 0.90; }
      function hx(d) { return d.kind === 'concept' ? ax(d) : cx; }
      function hy(d) { return d.kind === 'concept' ? ay(d) : cy; }
      function pull(d) { return d.kind === 'concept' ? 0.62 : 0.006; }

      var sim = d3.forceSimulation(data.nodes)
        .force('link', d3.forceLink(data.links).id(function (d) { return d.id; })
          .distance(function (d) { return (d.w > 1 ? 64 : 108) * R; })
          .strength(function (d) { return d.w > 1 ? 0.34 : 0.10; }))
        .force('charge', d3.forceManyBody().strength(FULL ? -108 : -74).distanceMax(340))
        .force('x', d3.forceX(hx).strength(pull))
        .force('y', d3.forceY(hy).strength(pull))
        .force('collide', d3.forceCollide().radius(function (d) { return radius(d) * 1.5 + 7 * R; }).iterations(3));

      function arc(d) {
        var dx = d.target.x - d.source.x, dy = d.target.y - d.source.y;
        var dr = Math.sqrt(dx * dx + dy * dy) * 2.6;
        return 'M' + d.source.x + ',' + d.source.y + 'A' + dr + ',' + dr + ' 0 0,1 ' + d.target.x + ',' + d.target.y;
      }
      var tickN = 0;
      function tick() {
        link.attr('d', arc);
        node.attr('transform', function (d) { return 'translate(' + d.x + ',' + d.y + ')'; });
        // Re-pick the labels a few times on the way down rather than only at rest,
        // so the overlap is not on screen for the whole settle.
        if (++tickN % 12 === 0 && sim.alpha() < 0.2) declutter();
      }

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { sim.stop(); for (var i = 0; i < 260; i++) sim.tick(); tick(); declutter(); }
      else { sim.on('tick', tick); sim.on('end', declutter); }
      requestAnimationFrame(function () { g.classed('kg-in', true); });

      // The graph fills most of the viewport, so a wheel over it used to swallow
      // the page scroll. Zoom is armed by a click and dropped on the way out;
      // an unarmed wheel is simply not handled, and the page scrolls as normal.
      var armed = false;
      function arm(on) {
        if (armed === on) return;
        armed = on;
        box.classList.toggle('kg-armed', on);
      }
      var zoom = d3.zoom().scaleExtent([0.4, 5])
        .filter(function (e) {
          if (e.type === 'wheel') return armed;
          // A pinch is deliberate enough to allow unarmed; a one-finger drag is
          // how the page is scrolled on touch, so that one waits to be armed.
          if (e.type === 'touchstart' || e.type === 'touchmove') return armed || (e.touches && e.touches.length > 1);
          return !e.ctrlKey && !e.button;
        })
        .on('zoom', function (e) { g.attr('transform', e.transform); });
      svg.call(zoom);

      box.addEventListener('pointerdown', function () { arm(true); });
      box.addEventListener('pointerleave', function () { arm(false); });
      document.addEventListener('pointerdown', function (e) { if (!box.contains(e.target)) arm(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') arm(false); });

      var neighbours = {};
      data.links.forEach(function (l) {
        (neighbours[l.source.id] = neighbours[l.source.id] || {})[l.target.id] = 1;
        (neighbours[l.target.id] = neighbours[l.target.id] || {})[l.source.id] = 1;
      });

      if (onto) {
        link.style('cursor', 'help')
          .on('mouseenter', function (e, l) {
            // An edge here is an assertion, so hovering has to show the claim,
            // how strong it is, and whether anything published stands behind it.
            var badge = { D: 'definitional', M: 'methodological', E: 'empirical' }[l.claim] || '';
            var src = l.src
              ? '<span class="kg-src">' + (/^arXiv:/.test(l.src)
                  ? l.src
                  : 'doi:' + l.src) + '</span>'
              : '<span class="kg-src kg-nosrc">no source asserted</span>';
            tip.innerHTML = '<b>' + l.id + ' &middot; ' + badge + ' &middot; ' + l.conf + '</b>'
              + '<span class="kg-triple">' + l.source.label + ' <em>' + l.rel + '</em> ' + l.target.label + '</span>'
              + '<span class="kg-note">' + l.note + '</span>' + src;
            var r = stage.getBoundingClientRect();
            tip.style.left = Math.max(4, Math.min(box.clientWidth - 240, e.clientX - r.left + 12)) + 'px';
            tip.style.top = Math.min(r.height - 90, e.clientY - r.top + 12) + 'px';
            tip.style.opacity = 1;
            link.attr('stroke-opacity', function (x) { return x === l ? 0.9 : 0.04; });
          })
          .on('mouseleave', function () {
            tip.style.opacity = 0;
            link.attr('stroke-opacity', function (d) { return d.w > 1 ? 0.30 : 0.11; });
          });
      }

      node.on('mouseenter', function (e, d) {
          tip.innerHTML = '<b>' + (onto ? d.sector : (KIND[d.kind] || '')) + '</b>' + d.label;
          var r = stage.getBoundingClientRect();
          tip.style.left = Math.max(4, Math.min(box.clientWidth - 200, e.clientX - r.left + 12)) + 'px';
          tip.style.top = Math.min(r.height - 60, e.clientY - r.top + 12) + 'px';
          tip.style.opacity = 1;
          var near = neighbours[d.id] || {};
          link.attr('stroke-opacity', function (l) {
            return (l.source.id === d.id || l.target.id === d.id) ? 0.9 : 0.04;
          });
          node.selectAll('circle').attr('opacity', function () {
            var n = d3.select(this.parentNode).datum();
            return (n.id === d.id || near[n.id]) ? 1 : 0.09;
          });
          node.selectAll('text').attr('opacity', function () {
            var n = d3.select(this.parentNode).datum();
            return (n.id === d.id || near[n.id]) ? 1 : 0.12;
          });
        })
        .on('mouseleave', function () {
          tip.style.opacity = 0;
          link.attr('stroke-opacity', function (l) { return l.w > 1 ? 0.30 : 0.11; });
          node.selectAll('circle').attr('opacity', 1);
          node.selectAll('text').attr('opacity', 1);
        })
        .on('click', function (e, d) { if (d.url) window.location.href = d.url; });

      if (FULL) {
        node.call(d3.drag()
          .on('start', function (e, d) { if (!e.active) sim.alphaTarget(0.25).restart(); d.fx = d.x; d.fy = d.y; svg.classed('kg-drag', true); })
          .on('drag', function (e, d) { d.fx = e.x; d.fy = e.y; })
          .on('end', function (e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; svg.classed('kg-drag', false); }));
      }

      var bar = document.getElementById('kg-bar{% if kg_full %}-full{% endif %}');

      new MutationObserver(function () {
        var g = getComputedStyle(wrap);
        var ch = parseFloat(g.getPropertyValue('--kg-halo-c')) || CH;
        var ph = parseFloat(g.getPropertyValue('--kg-halo-p')) || PH;
        SECTOR_COLOR = PALETTE[isDark() ? 'dark' : 'light'];
        node.selectAll('circle').attr('fill', function () { return paint(d3.select(this.parentNode).datum()); });
        node.selectAll('.kg-halo').attr('fill-opacity', function () {
          return d3.select(this.parentNode).datum().kind === 'concept' ? ch : ph;
        });
        link.attr('stroke', function (l) { return SECTOR_COLOR[l.target.sector] || SECTOR_COLOR._; });
        if (bar) bar.querySelectorAll('.kg-chip i').forEach(function (el, i) {
          el.style.background = SECTOR_COLOR[ORDER[i]];
        });
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      var c = document.createElement('div');
      c.className = 'kg-count';
      c.textContent = data.nodes.length + ' nodes, ' + data.links.length + ' links';
      box.appendChild(c);

      if (bar) {
        // Everything that touches a sector, not only the nodes filed under it
        var touches = {};
        data.links.forEach(function (l) {
          if (l.target.kind === 'concept') {
            (touches[l.target.sector] = touches[l.target.sector] || {})[l.source.id] = 1;
            touches[l.target.sector][l.target.id] = 1;
          }
        });

        // A search and a sector chip are two ways of choosing the same thing, so
        // they share one path: `keep` is the id set to show, or null for all.
        function apply(keep) {
          node.style('display', function (d) {
            d._hidden = !(!keep || keep[d.id]);
            return d._hidden ? 'none' : null;
          });
          link.style('display', function (l) {
            return (!keep || (keep[l.source.id] && keep[l.target.id])) ? null : 'none';
          });
          // Isolating a sector frees the space the hidden labels were taking,
          // so the survivors are re-chosen against what is actually on screen.
          declutter();
        }

        function select(sector) {
          bar.querySelectorAll('.kg-chip').forEach(function (b) {
            b.classList.toggle('on', b.getAttribute('data-s') === sector);
          });
          find.value = '';
          found.hidden = true;
          apply(sector === 'all' ? null : (touches[sector] || {}));
        }

        // Search keeps a match and everything one link away from it, so a hit
        // arrives with the context that explains why it is a hit.
        var find = wrap.querySelector('.kg-find');
        var found = wrap.querySelector('.kg-found');
        var adj = {};
        data.links.forEach(function (l) {
          (adj[l.source.id] = adj[l.source.id] || []).push(l.target.id);
          (adj[l.target.id] = adj[l.target.id] || []).push(l.source.id);
        });
        function search(q) {
          q = (q || '').trim().toLowerCase();
          if (!q) {
            found.hidden = true;
            var on = bar.querySelector('.kg-chip.on');
            var sec = on ? on.getAttribute('data-s') : 'all';
            apply(sec === 'all' ? null : (touches[sec] || {}));
            return;
          }
          bar.querySelectorAll('.kg-chip').forEach(function (b) {
            b.classList.toggle('on', b.getAttribute('data-s') === 'all');
          });
          var hits = data.nodes.filter(function (d) {
            return (d.label || '').toLowerCase().indexOf(q) !== -1;
          });
          var keep = {};
          hits.forEach(function (d) {
            keep[d.id] = 1;
            (adj[d.id] || []).forEach(function (n) { keep[n] = 1; });
          });
          found.hidden = false;
          found.textContent = hits.length
            ? hits.length + (hits.length === 1 ? ' match' : ' matches') + ', with what they link to'
            : 'no match';
          apply(hits.length ? keep : {});
        }
        // The input survives re-renders, so its listeners are attached once and
        // then re-pointed at the current view's search closure.
        find._kgSearch = search;
        if (!find._kgBound) {
          find._kgBound = true;
          var findTimer = null;
          find.addEventListener('input', function () {
            clearTimeout(findTimer);
            findTimer = setTimeout(function () { find._kgSearch(find.value); }, 130);
          });
          find.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { find.value = ''; find._kgSearch(''); find.blur(); }
          });
        }
        find.value = '';
        found.hidden = true;

        // render() runs again on every view switch, so the chips are rebuilt from
        // whichever ORDER is current rather than left describing the other view.
        bar.querySelectorAll('.kg-chip').forEach(function (b) { b.remove(); });
        var all = document.createElement('button');
        all.type = 'button'; all.className = 'kg-chip kg-all on'; all.setAttribute('data-s', 'all');
        all.textContent = 'All';
        all.addEventListener('click', function () { select('all'); });
        bar.insertBefore(all, bar.querySelector('.kg-links'));
        ORDER.forEach(function (name) {
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'kg-chip'; b.setAttribute('data-s', name);
          b.innerHTML = '<i style="background:' + SECTOR_COLOR[name] + '"></i>' + name;
          b.addEventListener('click', function () { select(name); });
          bar.insertBefore(b, bar.querySelector('.kg-links'));
        });
      }
    }

    var io = new IntersectionObserver(function (entries) {
      if (entries.some(function (x) { return x.isIntersecting; })) {
        io.disconnect();
        if (window.d3) boot();
        else { var t = setInterval(function () { if (window.d3) { clearInterval(t); boot(); } }, 60); setTimeout(function(){ clearInterval(t); }, 8000); }
      }
    }, { rootMargin: '150px' });
    io.observe(box);
  })();
</script>
