{% comment %}
  Knowledge graph of the site's own corpus, drawn along the axis the research
  actually sits on. Clinical concepts on the left, computational concepts on the
  right, and every study note, paper review and insight linked to the concepts it
  discusses, so the writing that joins both sides is visible as such. Concept
  assignment is by keyword frequency over the corpus, computed at build time into
  assets/json/knowledge-graph.json.
  Params: full (true for the interactive version), height.
{% endcomment %}
{% assign kg_full = include.full | default: false %}
{% assign kg_h = include.height | default: 480 %}

<style>
  /* Light is the default; dark takes over with the site's own theme switch and
     with the system preference when the reader has not chosen. */
  .kg-wrap {
    position: relative; margin: .45rem 0 0;
    --kg-g1: #ffffff; --kg-g2: #f3f5f9; --kg-g3: #eceff5;
    --kg-border: rgba(0,0,0,.09);
    --kg-label: #22262e; --kg-label-stroke: #ffffff;
    --kg-hub: #101319;
    --kg-line: #55607a;
    --kg-halo-c: .13; --kg-halo-p: .10;
    --kg-tip-bg: #ffffff; --kg-tip-fg: #1c1c1c; --kg-tip-bd: rgba(0,0,0,.12);
    --kg-tip-sh: rgba(0,0,0,.14);
    --kg-dim: #8a94a6; --kg-node-stroke: #ffffff;
  }
  html[data-theme="dark"] .kg-wrap {
    --kg-g1: #16161f; --kg-g2: #0c0c12; --kg-g3: #08080c;
    --kg-border: rgba(255,255,255,.07);
    --kg-label: #cbd2dc; --kg-label-stroke: #0a0a0f;
    --kg-hub: #e8edf4;
    --kg-line: #6b7280;
    --kg-halo-c: .16; --kg-halo-p: .09;
    --kg-tip-bg: #12121a; --kg-tip-fg: #e8edf4; --kg-tip-bd: rgba(255,255,255,.11);
    --kg-tip-sh: rgba(0,0,0,.5);
    --kg-dim: #4b5563; --kg-node-stroke: #0a0a0f;
  }
  .kg-stage { position: relative; display: flex; align-items: stretch; gap: .7rem; }
  .kg-stage > .kg-box { flex: 1 1 auto; min-width: 0; }
  .kg-bar {
    flex: 0 0 auto; width: 11.6rem; display: flex; flex-direction: column;
    gap: .26rem; justify-content: center;
  }
  @media (max-width: 700px) {
    .kg-stage { flex-direction: column; }
    .kg-bar { width: auto; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }
  }
  .kg-chip {
    padding: .26rem .6rem; border-radius: 8px; cursor: pointer;
    border: 1px solid var(--kg-border); background: none; color: inherit;
    font-size: .7rem; font-weight: 600; letter-spacing: .01em; transition: all .14s ease;
    display: flex; align-items: center; gap: .42rem; text-align: left; line-height: 1.25;
  }
  @media (max-width: 700px) { .kg-chip { flex: 0 0 auto; } }
  .kg-chip i { width: .5rem; height: .5rem; border-radius: 50%; display: inline-block; flex: 0 0 auto; }
  .kg-chip:hover { border-color: currentColor; }
  .kg-chip.off { opacity: .34; }
  .kg-box {
    position: relative; width: 100%; border-radius: 14px; overflow: hidden;
    border: 1px solid var(--kg-border);
    background:
      radial-gradient(90% 70% at 50% 40%, var(--kg-g1) 0%, var(--kg-g2) 55%, var(--kg-g3) 100%);
  }
  .kg-box svg { display: block; width: 100%; height: 100%; cursor: grab; }
  .kg-box svg.kg-drag { cursor: grabbing; }
  .kg-canvas { opacity: 0; transition: opacity .6s ease; }
  .kg-canvas.kg-in { opacity: 1; }
  .kg-link { fill: none; transition: stroke-opacity .18s ease; }
  .kg-node { cursor: pointer; }
  .kg-node circle { transition: opacity .18s ease; }
  .kg-halo { pointer-events: none; }
  .kg-label {
    font-size: 9.5px; fill: var(--kg-label); pointer-events: none; font-weight: 600;
    letter-spacing: .005em; transition: opacity .18s ease;
    paint-order: stroke; stroke: var(--kg-label-stroke); stroke-width: 3px; stroke-linejoin: round;
  }
  .kg-label.kg-hub { font-size: 11px; font-weight: 700; fill: var(--kg-hub); }
  .kg-legendline { font-size: .7rem; opacity: .55; margin: .5rem 0 0; line-height: 1.6; }
  .kg-note { font-size: .75rem; opacity: .55; margin: .35rem 0 0; line-height: 1.6; }
  .kg-tip {
    position: absolute; pointer-events: none; opacity: 0; transition: opacity .12s ease;
    background: var(--kg-tip-bg); border: 1px solid var(--kg-tip-bd); color: var(--kg-tip-fg);
    border-radius: 8px; padding: .4rem .62rem; font-size: .76rem; max-width: 18rem;
    line-height: 1.4; box-shadow: 0 6px 22px var(--kg-tip-sh); z-index: 3;
  }
  .kg-tip b { display: block; font-size: .64rem; font-weight: 800; letter-spacing: .07em;
              text-transform: uppercase; opacity: .5; margin-bottom: .12rem; }
  .kg-cover { position: absolute; inset: 0; display: flex; align-items: center;
              justify-content: center; font-size: .78rem; color: var(--kg-dim); }
  .kg-count {
    position: absolute; right: .75rem; bottom: .6rem; font-size: .66rem; color: var(--kg-dim);
    font-variant-numeric: tabular-nums; pointer-events: none; letter-spacing: .02em;
  }
</style>

<div class="kg-wrap">
  <div class="kg-stage">
    <div class="kg-box" id="kg-box{% if kg_full %}-full{% endif %}" style="height: {{ kg_h }}px;">
      <div class="kg-cover">Loading the graph…</div>
    </div>
    <div class="kg-bar" id="kg-bar{% if kg_full %}-full{% endif %}"></div>
    <div class="kg-tip"></div>
  </div>
  {% unless kg_full %}<p class="kg-note">Clinical vocabulary across the top, computational across the bottom, and every piece of writing placed by what it actually discusses. <a href="{{ '/research/#graph' | relative_url }}">Open the full graph</a>.</p>{% endunless %}
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js" integrity="sha512-vc58qvvBdrDR4etbxMdlTt4GBQk1qjvyORR2nrsPsFPyrs+/u5c3+1Ct6upOgdZoIl7eq6k3a1UPDSNAQi/32A==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
<script>
  (function () {
    var boxId = 'kg-box{% if kg_full %}-full{% endif %}';
    var FULL = {{ kg_full }};
    var box = document.getElementById(boxId);
    if (!box) return;
    var wrap = box.closest('.kg-wrap');
    var tip = wrap.querySelector('.kg-tip');
    var stage = box.parentNode;
    var ORDER = ['Imaging & acquisition','Disease & pathology','Clinical practice',
                 'Interpretability','Auditing & causality','Evaluation & reliability','Systems & deployment'];
    var PALETTE = {
      dark: {
        'Imaging & acquisition':'#eab308','Disease & pathology':'#fd7318','Clinical practice':'#f472b6',
        'Interpretability':'#a78bfa','Auditing & causality':'#3b82f6',
        'Evaluation & reliability':'#5fadfe','Systems & deployment':'#10b981', _: '#6b7280'
      },
      light: {
        'Imaging & acquisition':'#B9860C','Disease & pathology':'#D2601B','Clinical practice':'#C8437A',
        'Interpretability':'#6D4FD6','Auditing & causality':'#2563EB',
        'Evaluation & reliability':'#2B86C5','Systems & deployment':'#0E9B73', _: '#7A8494'
      }
    };
    function isDark() { return document.documentElement.getAttribute('data-theme') === 'dark'; }
    var SECTOR_COLOR = PALETTE[isDark() ? 'dark' : 'light'];
    function paint(d) { return SECTOR_COLOR[d.sector] || SECTOR_COLOR._; }
    var hidden = {};
    var KIND = { concept: 'Concept', note: 'Study note', review: 'Paper review', insight: 'Insight' };
    var started = false;

    function boot() {
      if (started || !window.d3) return;
      started = true;
      d3.json('{{ "/assets/json/knowledge-graph.json" | relative_url }}').then(render).catch(function () {
        box.innerHTML = '<div class="kg-cover">The graph could not be loaded.</div>';
      });
    }

    function render(data) {
      box.innerHTML = '';
      var W = box.clientWidth, H = box.clientHeight;
      var R = FULL ? 0.95 : 0.72;
      var svg = d3.select(box).append('svg').attr('viewBox', [0, 0, W, H]);
      var g = svg.append('g').attr('class', 'kg-canvas');

      var cs = getComputedStyle(wrap);
      var CH = parseFloat(cs.getPropertyValue('--kg-halo-c')) || 0.16;
      var PH = parseFloat(cs.getPropertyValue('--kg-halo-p')) || 0.09;
      var maxPiece = d3.max(data.nodes.filter(function (d) { return d.kind !== 'concept'; }), function (d) { return d.deg; }) || 1;
      var maxHub = d3.max(data.nodes.filter(function (d) { return d.kind === 'concept'; }), function (d) { return d.deg; }) || 1;
      function radius(d) {
        if (d.kind === 'concept') return (3.4 + Math.sqrt(d.deg / maxHub) * 3.2) * R;
        return (1.7 + Math.sqrt(d.deg / maxPiece) * 1.7) * R;
      }

      var link = g.append('g')
        .selectAll('path').data(data.links).join('path')
        .attr('class', 'kg-link')
        .attr('stroke', function (d) { var t = d.target; return (t && SECTOR_COLOR[t.sector]) || SECTOR_COLOR._; })
        .attr('stroke-opacity', function (d) { return d.w > 1 ? 0.30 : 0.11; })
        .attr('stroke-width', function (d) { return (d.w > 1 ? 1.15 : 0.7) * R; });

      var node = g.append('g').selectAll('g').data(data.nodes).join('g').attr('class', 'kg-node');
      node.append('circle').attr('class', 'kg-halo')
        .attr('r', function (d) { return radius(d) * (d.kind === 'concept' ? 2.2 : 1.9); })
        .attr('fill', paint)
        .attr('fill-opacity', function (d) { return d.kind === 'concept' ? CH : PH; });
      node.append('circle')
        .attr('r', radius)
        .attr('fill', paint)
        .attr('fill-opacity', function (d) { return d.kind === 'concept' ? 1 : 0.82; })
        .attr('stroke', function (d) { return d.kind === 'concept' ? 'var(--kg-node-stroke)' : 'none'; })
        .attr('stroke-width', 1.2);

      node.filter(function (d) { return d.kind === 'concept'; })
        .append('text').attr('class', 'kg-label kg-hub')
        .attr('dy', function (d) { return -radius(d) - 5 * R; })
        .attr('text-anchor', 'middle')
        .text(function (d) { return d.label; });

      // Give each family its own territory so the four groups read as groups,
      // and cross-links between them bend toward each other rather than mixing.
      // Seven sectors around a ring, clinical through the top half and computational
      // through the bottom. Only concepts are placed; the writing settles wherever
      // its own links pull it, which is the part worth looking at.
      var cx = W / 2, cy = H / 2, rad = Math.min(W, H) * (FULL ? 0.46 : 0.50);
      // One slot per concept around the ring, ordered so a sector occupies a
      // contiguous arc. Sending six concepts to one sector anchor piled them up.
      var hubs = data.nodes.filter(function (d) { return d.kind === 'concept'; });
      hubs.sort(function (a, b) {
        var t = ORDER.indexOf(a.sector) - ORDER.indexOf(b.sector);
        return t || a.label.localeCompare(b.label);
      });
      var GAP = 0.055, span = (Math.PI * 2) - ORDER.length * GAP;
      var ANG = {}, at = -Math.PI / 2, prev = null;
      hubs.forEach(function (d) {
        if (prev !== null && d.sector !== prev) at += GAP;
        ANG[d.id] = at; at += span / hubs.length; prev = d.sector;
      });
      function ax(d) { return ANG[d.id] === undefined ? cx : cx + Math.cos(ANG[d.id]) * rad * 1.32; }
      function ay(d) { return ANG[d.id] === undefined ? cy : cy + Math.sin(ANG[d.id]) * rad * 0.90; }
      function hx(d) { return d.kind === 'concept' ? ax(d) : cx; }
      function hy(d) { return d.kind === 'concept' ? ay(d) : cy; }
      function pull(d) { return d.kind === 'concept' ? 0.62 : 0.006; }

      var sim = d3.forceSimulation(data.nodes)
        .force('link', d3.forceLink(data.links).id(function (d) { return d.id; })
          .distance(function (d) { return (d.w > 1 ? 64 : 108) * R; })
          .strength(function (d) { return d.w > 1 ? 0.34 : 0.10; }))
        .force('charge', d3.forceManyBody().strength(FULL ? -108 : -74).distanceMax(340))
        .force('x', d3.forceX(hx).strength(pull))
        .force('y', d3.forceY(hy).strength(pull))
        .force('collide', d3.forceCollide().radius(function (d) { return radius(d) * 1.5 + 7 * R; }).iterations(3));

      function arc(d) {
        var dx = d.target.x - d.source.x, dy = d.target.y - d.source.y;
        var dr = Math.sqrt(dx * dx + dy * dy) * 2.6;
        return 'M' + d.source.x + ',' + d.source.y + 'A' + dr + ',' + dr + ' 0 0,1 ' + d.target.x + ',' + d.target.y;
      }
      function tick() {
        link.attr('d', arc);
        node.attr('transform', function (d) { return 'translate(' + d.x + ',' + d.y + ')'; });
      }

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { sim.stop(); for (var i = 0; i < 260; i++) sim.tick(); tick(); }
      else sim.on('tick', tick);
      requestAnimationFrame(function () { g.classed('kg-in', true); });

      svg.call(d3.zoom().scaleExtent([0.4, 5]).on('zoom', function (e) { g.attr('transform', e.transform); }));

      var neighbours = {};
      data.links.forEach(function (l) {
        (neighbours[l.source.id] = neighbours[l.source.id] || {})[l.target.id] = 1;
        (neighbours[l.target.id] = neighbours[l.target.id] || {})[l.source.id] = 1;
      });

      node.on('mouseenter', function (e, d) {
          tip.innerHTML = '<b>' + (KIND[d.kind] || '') + '</b>' + d.label;
          var r = stage.getBoundingClientRect();
          tip.style.left = Math.max(4, Math.min(box.clientWidth - 200, e.clientX - r.left + 12)) + 'px';
          tip.style.top = Math.min(r.height - 60, e.clientY - r.top + 12) + 'px';
          tip.style.opacity = 1;
          var near = neighbours[d.id] || {};
          link.attr('stroke-opacity', function (l) {
            return (l.source.id === d.id || l.target.id === d.id) ? 0.9 : 0.04;
          });
          node.selectAll('circle').attr('opacity', function () {
            var n = d3.select(this.parentNode).datum();
            return (n.id === d.id || near[n.id]) ? 1 : 0.09;
          });
          node.selectAll('text').attr('opacity', function () {
            var n = d3.select(this.parentNode).datum();
            return (n.id === d.id || near[n.id]) ? 1 : 0.12;
          });
        })
        .on('mouseleave', function () {
          tip.style.opacity = 0;
          link.attr('stroke-opacity', function (l) { return l.w > 1 ? 0.30 : 0.11; });
          node.selectAll('circle').attr('opacity', 1);
          node.selectAll('text').attr('opacity', 1);
        })
        .on('click', function (e, d) { if (d.url) window.location.href = d.url; });

      if (FULL) {
        node.call(d3.drag()
          .on('start', function (e, d) { if (!e.active) sim.alphaTarget(0.25).restart(); d.fx = d.x; d.fy = d.y; svg.classed('kg-drag', true); })
          .on('drag', function (e, d) { d.fx = e.x; d.fy = e.y; })
          .on('end', function (e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; svg.classed('kg-drag', false); }));
      }

      var bar = document.getElementById('kg-bar{% if kg_full %}-full{% endif %}');

      new MutationObserver(function () {
        var g = getComputedStyle(wrap);
        var ch = parseFloat(g.getPropertyValue('--kg-halo-c')) || CH;
        var ph = parseFloat(g.getPropertyValue('--kg-halo-p')) || PH;
        SECTOR_COLOR = PALETTE[isDark() ? 'dark' : 'light'];
        node.selectAll('circle').attr('fill', function () { return paint(d3.select(this.parentNode).datum()); });
        node.selectAll('.kg-halo').attr('fill-opacity', function () {
          return d3.select(this.parentNode).datum().kind === 'concept' ? ch : ph;
        });
        link.attr('stroke', function (l) { return SECTOR_COLOR[l.target.sector] || SECTOR_COLOR._; });
        if (bar) bar.querySelectorAll('.kg-chip i').forEach(function (el, i) {
          el.style.background = SECTOR_COLOR[ORDER[i]];
        });
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      var c = document.createElement('div');
      c.className = 'kg-count';
      c.textContent = data.nodes.length + ' nodes, ' + data.links.length + ' links';
      box.appendChild(c);

      if (bar) {
        ORDER.forEach(function (name) {
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'kg-chip';
          b.innerHTML = '<i style="background:' + SECTOR_COLOR[name] + '"></i>' + name;
          b.addEventListener('click', function () {
            hidden[name] = !hidden[name];
            b.classList.toggle('off', !!hidden[name]);
            node.style('display', function (d) { return hidden[d.sector] ? 'none' : null; });
            link.style('display', function (l) {
              return (hidden[l.source.sector] || hidden[l.target.sector]) ? 'none' : null;
            });
          });
          bar.appendChild(b);
        });
      }
    }

    var io = new IntersectionObserver(function (entries) {
      if (entries.some(function (x) { return x.isIntersecting; })) {
        io.disconnect();
        if (window.d3) boot();
        else { var t = setInterval(function () { if (window.d3) { clearInterval(t); boot(); } }, 60); setTimeout(function(){ clearInterval(t); }, 8000); }
      }
    }, { rootMargin: '150px' });
    io.observe(box);
  })();
</script>
