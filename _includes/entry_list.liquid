{% comment %}
  Shared row styles for the index pages, matching the study library: a filter
  strip, then one row per piece with title, summary, and a meta line. Used by
  insights and paper reviews so all three collections read the same way.
{% endcomment %}
<style>
  .el-cats {
    display: flex; flex-wrap: wrap; gap: .3rem; margin: .9rem 0 .2rem;
    padding-bottom: .7rem; border-bottom: 2px solid var(--global-theme-color);
  }
  .el-cats .el-row-label {
    display: block; width: 100%; font-size: .68rem; font-weight: 800;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--global-text-color-light); opacity: .75; margin: .55rem 0 .1rem;
  }
  .el-cats .el-row-label:first-child { margin-top: 0; }
  .el-cats .el-row-label.el-inline { width: auto; margin: 0 .35rem 0 0; align-self: center; }
  .el-cat {
    padding: .18rem .6rem; border-radius: 999px; cursor: pointer; white-space: nowrap;
    border: 1px solid rgba(128,128,128,.32); background: none; color: inherit;
    font-size: .755rem; font-weight: 600; transition: all .15s ease;
  }
  .el-cat:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); }
  .el-cat.active { background: var(--global-theme-color); border-color: var(--global-theme-color); color: var(--site-on-accent); }
  .el-cat .el-cnt { opacity: .7; font-size: .69rem; margin-left: .1rem; font-variant-numeric: tabular-nums; }

  .el-list { margin: 1.1rem 0 0; }
  .el-row {
    display: block; text-decoration: none; color: inherit;
    padding: .78rem 0; border-bottom: 1px solid var(--global-divider-color);
  }
  .el-row.el-hidden { display: none; }
  a.el-row:hover .el-title { color: var(--global-theme-color); }
  a.el-row:hover .el-read { opacity: 1; }
  .el-title { font-size: .97rem; font-weight: 650; line-height: 1.4; }
  .el-sum { font-size: .845rem; line-height: 1.6; opacity: .68; margin-top: .12rem; max-width: 78ch; }
  .el-authors { font-size: .8rem; opacity: .5; margin-top: .1rem; font-style: italic; }
  .el-foot { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; margin-top: .3rem; }
  .el-tag {
    font-size: .68rem; font-weight: 700; letter-spacing: .04em;
    color: var(--global-text-color-light); opacity: .78;
  }
  .el-date { font-size: .72rem; opacity: .45; font-variant-numeric: tabular-nums; }
  .el-read {
    margin-left: auto; font-size: .78rem; font-weight: 600;
    color: var(--global-theme-color); opacity: .8; white-space: nowrap;
  }
  .el-empty { opacity: .6; line-height: 1.7; margin-top: 1rem; }
</style>
