{% comment %}
  Shared chrome for the index pages, matching the study library so the three
  collections read as one thing: the page's own name held back, a filter strip,
  then one row per piece with title, summary and a meta line. Used by insights
  and paper reviews.
{% endcomment %}
<style>
  /* The theme sets the page h1 at display size. An index leads with its
     contents, not with its own name, so it is held to the study page's size. */
  .post-title, article > h1, .page-title { font-size: 1.9rem; letter-spacing: -.02em; }

  /* Filter row. The count sits inside the pill as its own chip so it stays
     attached to its label when the row wraps, instead of reading as loose text
     beside it. A divider rule closes the strip: a theme-coloured bar competed
     with the titles underneath, which are the content. */
  .el-cats {
    display: flex; flex-wrap: wrap; gap: .32rem; margin: 1.1rem 0 .2rem;
    padding-bottom: .8rem; border-bottom: 1px solid var(--global-divider-color);
  }
  .el-cats .el-row-label {
    display: block; width: 100%;
    font-size: .665rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
    color: var(--global-text-color-light); opacity: .75; margin: .8rem 0 .15rem;
  }
  .el-cats .el-row-label:first-child { margin-top: 0; }
  .el-cats .el-row-label.el-inline { width: auto; margin: 0 .35rem 0 0; align-self: center; }
  .el-cat {
    display: inline-flex; align-items: center; gap: .36rem;
    padding: .24rem .68rem; border-radius: 999px; cursor: pointer; white-space: nowrap;
    border: 1px solid rgba(128,128,128,.3); background: none; color: inherit;
    font-size: .755rem; font-weight: 550; line-height: 1.5;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }
  .el-cat:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); }
  .el-cat.active { background: var(--global-theme-color); border-color: var(--global-theme-color); color: #fff; }
  .el-cat .el-cnt {
    font-size: .655rem; font-weight: 650; font-variant-numeric: tabular-nums;
    padding: .04rem .3rem; border-radius: 999px; margin: 0;
    background: rgba(128,128,128,.16); color: inherit;
  }
  .el-cat.active .el-cnt { background: rgba(255,255,255,.22); }

  /* Rows. The titles should be the loudest thing on the page. */
  .el-list { margin: 1.1rem 0 0; }
  .el-row {
    display: block; text-decoration: none; color: inherit;
    padding: .85rem 0; border-bottom: 1px solid var(--global-divider-color);
  }
  .el-row.el-hidden { display: none; }
  a.el-row:hover .el-title { color: var(--global-theme-color); }
  a.el-row:hover .el-read { opacity: 1; }
  .el-title { font-size: .975rem; font-weight: 600; line-height: 1.45; }
  .el-sum { font-size: .84rem; line-height: 1.65; opacity: .62; margin-top: .2rem; max-width: 72ch; }
  .el-authors { font-size: .79rem; opacity: .48; margin-top: .12rem; font-style: italic; }
  .el-foot { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; margin-top: .3rem; }
  .el-tag {
    font-size: .68rem; font-weight: 700; letter-spacing: .04em;
    color: var(--global-text-color-light); opacity: .75;
  }
  .el-date { font-size: .72rem; opacity: .45; font-variant-numeric: tabular-nums; }
  .el-read {
    margin-left: auto; font-size: .78rem; font-weight: 600;
    color: var(--global-theme-color); opacity: .8; white-space: nowrap;
  }
  .el-empty { font-size: .87rem; opacity: .6; padding: .6rem 0; }
</style>
