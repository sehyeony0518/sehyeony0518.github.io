@inproceedings{lee2026attention,
  abbr={IEIE},
  bibtex_show={true},
  title={Attention UWT-Net: Frequency-Aware Gated Skip Connections for Medical Image Segmentation},
  author={Lee, Seung-Gu and Hwang, Se-Hyeon and Choi, Hyeonjin and Lee, Jung-won},
  booktitle={Proceedings of the Fall Conference of the Institute of Electronics and Information Engineers (IEIE 2026)},
  year={2026},
  note={In Korean},
  abstract={Places attention gates on the skip connections of UWT-Net for medical image segmentation. The gating signal is the output of the IMFIE block, which is built to extract low-frequency information, so the criterion for passing an encoder feature to the decoder carries structural context rather than plain convolutional features. The gates cost under 5% additional parameters and computation. On BUSI and CVC-ClinicDB the model reaches 68.32% and 87.51% IoU, above the reported figures for the compared models, and the highest average across the three datasets evaluated. Analysis of the attention coefficients separates where the mechanism helps from where it does not: the gates emphasize the target when it occupies a small part of the image, and show no such selectivity on GlaS, where the target covers most of it. Work at the Embedded & Software Lab, Ajou University.}
}

