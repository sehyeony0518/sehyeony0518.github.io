layout: post
---

{%- comment -%}
  Wraps the theme's post layout so the insight posts can carry the same reading
  typography as the study notes. The theme's display heading sizes are meant for
  short pages; these run to a couple of thousand words.
{%- endcomment -%}
<style>
  /* Long-form reading. The theme sets h2 at 2rem and h3 at 1.75rem, which is
     display sizing: on a note with thirty-odd headings an h3 arrives nearly as
     loud as the page title and the page reads as a stack of banners. These are
     section markers inside running prose, so they are sized to be found when
     scanning without interrupting when reading, and each binds to the text it
     introduces by taking much more space above than below. */
  .sn-body h2, .sn-body h3, .sn-body h4 {
    font-weight: 600; letter-spacing: -0.005em; line-height: 1.3;
    color: inherit; border: 0; padding: 0;
  }
  .sn-body h2 {
    font-size: 1.28rem; margin: 2.9rem 0 .75rem;
    padding-bottom: .4rem; border-bottom: 1px solid var(--global-divider-color);
  }
  .sn-body h3 { font-size: 1.05rem; margin: 2.1rem 0 .55rem; }
  .sn-body h4 {
    font-size: .93rem; margin: 1.5rem 0 .4rem; font-weight: 650;
    color: var(--global-text-color-light);
  }
  .sn-body > h2:first-child, .sn-body > h3:first-child { margin-top: 1.2rem; }

  /* No narrower measure than the title and the rule above it. A 68ch limit reads
     well in isolation but leaves the body visibly inset from the heading and the
     divider, which span the column, and the page looks misaligned. Line height
     carries the readability instead. */
  .sn-body p { line-height: 1.75; margin: 0 0 1.05rem; }
  .sn-body li { line-height: 1.7; margin-bottom: .3rem; }

  .sn-body table { font-size: .9rem; }
  .sn-body th { font-weight: 650; }
  .sn-body blockquote {
    border-left: 2px solid var(--global-divider-color);
    padding-left: .9rem; margin-left: 0; font-style: normal; opacity: .85;
  }
  .sn-body hr { margin: 2.6rem 0; border: 0; border-top: 1px solid var(--global-divider-color); }
  /* Footnote definitions are apparatus, not prose. */
  .sn-body .footnotes { font-size: .86rem; opacity: .75; }
  .sn-body .footnotes hr { margin-top: 3rem; }
</style>

<div class="sn-body">
{{ content }}
</div>
