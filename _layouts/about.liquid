</script>
<script>
  // First visit lands in dark. theme.js reads localStorage "theme" and falls back
  // to the system setting, so seeding the key is enough; a reader who picks a
  // theme afterwards keeps their choice.
  (function () {
    try {
      if (localStorage.getItem('theme')) return;
      localStorage.setItem('theme', 'dark');
      document.documentElement.setAttribute('data-theme-setting', 'dark');
      document.documentElement.setAttribute('data-theme', 'dark');
      if (typeof applyTheme === 'function') applyTheme();
    } catch (e) {}
  })();
</script>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        <span class="font-weight-bold">Se-Hyeon</span> Hwang <span class="h1-ko" lang="ko">황세현</span>
      {% endif %}
    </h1>
    <p class="hero-tagline"><span class="hero-text">Medical XAI Researcher</span><span class="hero-caret" aria-hidden="true"></span></p>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <style>
    .h1-ko { font-size: .52em; font-weight: 600; opacity: .55; letter-spacing: -.01em; margin-left: .18em; }
    .hero-tagline {
      margin: 0.3rem 0 0.4rem;
      /* Inter rather than the Montserrat of the name above, so the two lines read
         as different things rather than competing */
      font-family: Inter, "Helvetica Neue", Arial, sans-serif;
      font-size: clamp(1.2rem, 2.5vw, 1.62rem);
      font-weight: 600;
      letter-spacing: -0.012em;
      line-height: 1.25;
      color: var(--global-text-color);
      min-height: 1.25em; /* hold the line so the rotation does not shift the page */
    }
    @media (max-width: 480px) {
      .hero-tagline { min-height: 2.5em; } /* room for a wrap on narrow screens */
    }
    .hero-tagline .hero-text { color: var(--global-theme-color); }
    .hero-caret {
      display: inline-block;
      width: 2px;
      height: 0.95em;
      margin-left: 0.1em;
      vertical-align: -0.1em;
      background: var(--global-theme-color);
      opacity: 0;
    }
    .hero-caret.on { animation: heroBlink 1.05s steps(1, end) infinite; }
    @keyframes heroBlink { 0%, 50% { opacity: 0.9; } 50.01%, 100% { opacity: 0; } }
  </style>

  <script>
    (function () {
      var el = document.querySelector('.hero-tagline .hero-text');
      var caret = document.querySelector('.hero-tagline .hero-caret');
      if (!el || !caret) return;
      // The resting phrase is already in the HTML, so it stands without JS
      // and for anyone who has asked for reduced motion.
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // Claims argued in the notes, in the field's own vocabulary. Weighted toward
      // interpretability and auditing of image models, which is where the work sits.
      var phrases = [
        'AUROC depends on disease spectrum',
        'Decodability is not reliance',
        'Completeness is not plausibility',
        'TCAV is not a causal proportion',
        'Deletion curves depend on edits',
        'Null ablations can hide redundancy',
        'Medical XAI Researcher'
      ];
      var TYPE = 52, ERASE = 26, HOLD = 820;
      var p = 0, i = 0, erasing = false;

      el.textContent = '';
      caret.classList.add('on');

      (function step() {
        var word = phrases[p];
        var last = p === phrases.length - 1;

        if (!erasing) {
          el.textContent = word.slice(0, ++i);
          if (i < word.length) return setTimeout(step, TYPE);
          if (last) {
            // settle here: retire the caret and leave the phrase up
            return setTimeout(function () {
              caret.classList.remove('on');
              caret.style.opacity = '0';
            }, 2400);
          }
          erasing = true;
          return setTimeout(step, HOLD);
        }

        el.textContent = word.slice(0, --i);
        if (i > 0) return setTimeout(step, ERASE);
        erasing = false;
        p++;
        setTimeout(step, 220);
      })();
    })();
  </script>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">journey</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Recent prayer letter (mission-side only; enable with prayer_preview: true) -->
    {% assign latest_letter = site.prayer | sort: 'date' | reverse | first %}
    {% if page.prayer_preview and latest_letter %}
      <h2>
        <a href="{{ '/prayer/' | relative_url }}" style="color: inherit">recent prayer</a>
      </h2>
      <style>
        .rp-card { display: flex; gap: 1rem; text-decoration: none; color: inherit; margin-top: .6rem;
          border: 1px solid rgba(128,128,128,.18); border-radius: 14px; overflow: hidden;
          background: rgba(128,128,128,.03); transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease; }
        .rp-card:hover { border-color: var(--global-theme-color); transform: translateY(-2px); box-shadow: 0 6px 22px rgba(0,0,0,.07); }
        .rp-card .rp-thumb { flex: 0 0 34%; max-width: 210px; background-size: cover; background-position: center; background-color: rgba(128,128,128,.1); }
        @media (max-width: 520px) { .rp-card { flex-direction: column; } .rp-card .rp-thumb { flex-basis: 150px; max-width: none; height: 150px; } }
        .rp-card .rp-body { padding: 1rem 1.15rem; display: flex; flex-direction: column; }
        .rp-card .rp-badge { align-self: flex-start; font-size: .68rem; font-weight: 800; letter-spacing: .04em;
          padding: .16rem .55rem; border-radius: 999px; background: var(--global-theme-color); color: #fff; margin-bottom: .45rem; }
        .rp-card h3 { margin: 0 0 .4rem; font-size: 1.08rem; line-height: 1.35; }
        .rp-card .rp-sum { font-size: .85rem; opacity: .7; line-height: 1.55; margin: 0; }
        .rp-viewall { display: inline-block; margin: .85rem 0 0; font-size: .82rem; text-decoration: none; color: var(--global-theme-color); }
        .rp-viewall:hover { text-decoration: underline; }
      </style>
      <a class="rp-card" href="{{ latest_letter.url | relative_url }}">
        {% if latest_letter.cover %}
          <div class="rp-thumb" style="background-image:url('{{ '/assets/img/gallery/' | append: latest_letter.cover | append: '.jpg' | relative_url }}');"></div>
        {% endif %}
        <div class="rp-body">
          <span class="rp-badge">{{ latest_letter.issue }}</span>
          <h3>{{ latest_letter.title | remove: latest_letter.issue | remove: ' · ' | strip }}</h3>
          {% if latest_letter.summary %}<p class="rp-sum">{{ latest_letter.summary }}</p>{% endif %}
        </div>
      </a>
      <a class="rp-viewall" href="{{ '/prayer/' | relative_url }}">View All Prayer Letters &rarr;</a>
    {% endif %}

    <!-- Latest insights + paper reviews (medical AI / digital healthcare) -->
    {% if page.blog_preview %}
      <div class="hb-wrap">
        <div class="hb-toggle" id="hb-toggle">
          <button type="button" class="hb-btn active" data-view="map">graph</button>
          <button type="button" class="hb-btn" data-view="reading">selected reading</button>
        </div>

      <div class="hb-pane" data-pane="map">
        {% include knowledge_graph.liquid height=560 %}
      </div>
      <div class="hb-pane hb-hidden" data-pane="reading">
        {% include latest_blog.liquid %}
      </div>
      </div>


      <style>
        /* The heading is gone: the panel names itself in its own top corner, and the
           switch sits on the panel's top line at the right, over the filter column. */
        .hb-wrap { position: relative; margin-top: .2rem; }
        .hb-toggle { position: absolute; top: 0; right: 0; z-index: 4; display: flex; gap: .3rem; }
        [data-pane="map"] .kg-bar { padding-top: 2.4rem; }
        [data-pane="reading"] { padding-top: 2.4rem; }
        @media (max-width: 700px) {
          .hb-toggle { position: static; margin-bottom: .5rem; }
          [data-pane="map"] .kg-bar, [data-pane="reading"] { padding-top: 0; }
        }
        .hb-btn {
          padding: .2rem .68rem; border-radius: 999px; cursor: pointer; white-space: nowrap;
          border: 1px solid rgba(128,128,128,.32); background: none; color: inherit;
          font-size: .76rem; font-weight: 600; transition: all .15s ease;
        }
        .hb-btn:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); }
        .hb-btn.active {
          background: var(--global-theme-color); border-color: var(--global-theme-color); color: #fff;
        }
        .hb-pane.hb-hidden { display: none; }
      </style>
      <script>
        (function () {
          var bar = document.getElementById('hb-toggle');
          if (!bar) return;
          var panes = document.querySelectorAll('.hb-pane');

          function show(view, remember) {
            if (view !== 'map' && view !== 'reading') return;
            bar.querySelectorAll('.hb-btn').forEach(function (b) {
              b.classList.toggle('active', b.getAttribute('data-view') === view);
            });
            panes.forEach(function (p) {
              p.classList.toggle('hb-hidden', p.getAttribute('data-pane') !== view);
            });
            // The graph builds on an IntersectionObserver, so revealing the pane
            // is enough: it draws itself the first time it is actually on screen.
            if (remember) { try { sessionStorage.setItem('homeView', view); } catch (e) {} }
          }

          bar.addEventListener('click', function (e) {
            var b = e.target.closest('.hb-btn');
            if (b) show(b.getAttribute('data-view'), true);
          });

          var saved = null;
          try { saved = sessionStorage.getItem('homeView'); } catch (e) {}
          if (saved && saved !== 'map') show(saved, false);
        })();
      </script>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/diary/' | relative_url }}" style="color: inherit">recent reflections</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Photo preview -->
    {% if page.photo_preview %}
      <h2>
        <a href="{{ '/photos/' | relative_url }}" style="color: inherit">photos</a>
      </h2>
      <style>
        .photo-strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin: 0.6rem 0 0.3rem; }
        @media (min-width: 576px) { .photo-strip { grid-template-columns: repeat(5, 1fr); } }
        .photo-strip a { display: block; border-radius: 8px; overflow: hidden; aspect-ratio: 1 / 1; }
        .photo-strip img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
        .photo-strip a:hover img { transform: scale(1.06); }
        .photo-more { display: inline-block; margin-top: 0.5rem; font-size: 0.82rem; text-decoration: none; color: var(--global-theme-color); }
        .photo-more:hover { text-decoration: underline; }
      </style>
      <div class="photo-strip">
        {% assign preview_ids = "g24,g35,g38,g41,g53" | split: "," %}
        {% for id in preview_ids %}
          <a href="{{ '/photos/' | relative_url }}"><img loading="lazy" src="{{ '/assets/img/gallery/' | append: id | append: '.jpg' | relative_url }}" alt="photo"></a>
        {% endfor %}
      </div>
      <a class="photo-more" href="{{ '/photos/' | relative_url }}">View All Photos &rarr;</a>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Affiliations. The social icons live in the bar under the navbar, so
         repeating them here only duplicated them. -->
    <div class="affil">
      <a class="lo-word" href="https://eslab.ajou.ac.kr/" target="_blank" rel="noopener" aria-label="Embedded and Software Lab">
        <img class="lo-l" src="{{ '/assets/img/logos/ens.png' | relative_url }}" alt="Embedded &amp; Software Lab" loading="lazy">
        <img class="lo-d" src="{{ '/assets/img/logos/ens_dark.png' | relative_url }}" alt="" aria-hidden="true" loading="lazy">
      </a>
      <a href="https://www.ajou.ac.kr/en/index.do" target="_blank" rel="noopener" aria-label="Ajou University">
        <img class="lo-l" src="{{ '/assets/img/logos/ajou.png' | relative_url }}" alt="Ajou University" loading="lazy">
        <img class="lo-d" src="{{ '/assets/img/logos/ajou_dark.png' | relative_url }}" alt="" aria-hidden="true" loading="lazy">
      </a>
      <a href="https://hosp.ajoumc.or.kr/" target="_blank" rel="noopener" aria-label="Ajou University Medical Center">
        <img class="lo-l" src="{{ '/assets/img/logos/ajoumc.png' | relative_url }}" alt="Ajou University Medical Center" loading="lazy">
        <img class="lo-d" src="{{ '/assets/img/logos/ajoumc_dark.png' | relative_url }}" alt="" aria-hidden="true" loading="lazy">
      </a>
      <a href="https://itrc.ajou.ac.kr/" target="_blank" rel="noopener" aria-label="ITRC">
        <img class="lo-l" src="{{ '/assets/img/logos/itrc.png' | relative_url }}" alt="ITRC" loading="lazy">
        <img class="lo-d" src="{{ '/assets/img/logos/itrc_dark.png' | relative_url }}" alt="" aria-hidden="true" loading="lazy">
      </a>
    </div>

    <style>
      /* The row deliberately breaks out past the prose column: these are the
         page's closing marks, and at body width they read as thumbnails. */
      .affil {
        width: min(1180px, 94vw); margin-left: 50%; transform: translateX(-50%);
        display: flex; align-items: center; justify-content: space-between;
        gap: 1.1rem; height: 150px; margin-top: 1rem; margin-bottom: .6rem;
      }
      .affil a { display: flex; align-items: center; justify-content: center; height: 100%; min-width: 0; }
      /* Set to a shared height the seals read level, but the wordmark is three
         and a half times as wide as it is tall, so matching cap heights makes it
         far the heaviest thing on the line. Holding it shorter evens the weight
         out and, because the row is space-between, widens every gap with it. */
      .affil .lo-word { height: 58%; }
      .affil img { height: 100%; width: auto; max-width: 100%; object-fit: contain;
        opacity: .82; transition: opacity .15s ease; }
      .affil a:hover img { opacity: 1; }
      /* Each mark ships twice — the ink is inverted in lightness for the dark
         ground, so black type reads white while the blues and reds stay themselves. */
      .affil .lo-d { display: none; }
      html[data-theme="dark"] .affil .lo-l { display: none; }
      html[data-theme="dark"] .affil .lo-d { display: block; }
      @media (max-width: 900px) { .affil { height: 104px; } }
      @media (max-width: 640px) {
        .affil { height: auto; flex-wrap: wrap; justify-content: center; gap: 1.6rem 2rem; }
        .affil a { height: 66px; flex: 0 0 auto; }
        .affil .lo-word { height: 42px; }
      }
    </style>

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
